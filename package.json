{
  "name": "anatomy-model-revision",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:data": "node scripts/build-data.mjs",
    "image:add": "node scripts/add-image.mjs",
    "structures:merge": "node scripts/merge-structures.mjs",
    "structure:find": "node scripts/find-structure.mjs",
    "desktop:vendor": "node scripts/build-desktop.mjs",
    "desktop:dev": "npm run desktop:vendor && electron .",
    "desktop:package": "npm run build:data && npm run desktop:vendor && electron-builder --mac dmg --arm64 --publish never",
    "desktop:package:all": "npm run build:data && npm run desktop:vendor && electron-builder --mac dmg --arm64 --x64 --publish never",
    "desktop:package:windows": "npm run build:data && npm run desktop:vendor && electron-builder --win nsis --x64 --publish never"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "ts-fsrs": "^6.0.0"
  },
  "productName": "Swansea GEM Anatomy",
  "description": "Offline anatomy revision with local spaced-repetition progress",
  "author": "Rhodri Davies",
  "main": "desktop/main.mjs",
  "build": {
    "appId": "uk.rhodridavies.swansea-gem-anatomy",
    "productName": "Swansea GEM Anatomy",
    "directories": {
      "output": "release",
      "buildResources": "desktop/resources"
    },
    "files": [
      "desktop/main.mjs",
      "desktop/preload.cjs",
      "desktop/progress-store.mjs",
      "dist/**/*",
      "package.json",
      "!dist/documents/bs5-5-key.pdf"
    ],
    "asar": true,
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.education",
      "identity": "-",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "Swansea-GEM-Anatomy-${version}-${arch}.${ext}",
      "icon": "desktop/resources/icon.png",
      "hardenedRuntime": true
    },
    "dmg": {
      "title": "Swansea GEM Anatomy",
      "contents": [
        {
          "x": 160,
          "y": 180,
          "type": "file"
        },
        {
          "x": 460,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Swansea-GEM-Anatomy-Setup-${version}-${arch}.${ext}",
      "signExecutable": false,
      "icon": "desktop/resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "afterSign": "scripts/verify-mac-signature.cjs"
  }
}
