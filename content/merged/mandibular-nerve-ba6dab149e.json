      "question": "Sensory functions",
      "preferredVariantId": "v-025d3484ba",
      "variants": [
        {
          "id": "v-025d3484ba",
          "answer": "Supplies lower face, mandibular teeth, anterior two-thirds of tongue for general sensation and parts of external ear and dura.",
          "sources": [
            {
              "modelId": "deep-face-model-bs8-1",
              "cardId": "deep-face-model-bs8-1-180",
              "sourceLine": 180
            }
          ]
