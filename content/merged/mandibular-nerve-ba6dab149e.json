      "preferredVariantId": "v-b73a4982e1",
      "variants": [
        {
          "id": "v-b73a4982e1",
          "answer": "Supplies muscles of mastication, mylohyoid, anterior belly of digastric, tensor tympani and tensor veli palatini.",
