      "preferredVariantId": null,
      "variants": [
        {
          "id": "v-29241de865",
          "answer": "Articulates with the opposite pubis at the pubic symphysis and contributes to the acetabulum and obturator foramen.",
          "sources": [
            {
              "modelId": "female-pelvis-model-mo8",
              "cardId": "female-pelvis-model-mo8-3",
              "sourceLine": 3
            }
          ]
        },
        {
          "id": "v-488f1bc966",
          "answer": "Meets opposite pubis at pubic symphysis; fuses with ilium and ischium in hip bone and contributes to acetabulum articulating with femoral head.",
          "sources": [
            {
              "modelId": "lower-limb-model-ns10",
              "cardId": "lower-limb-model-ns10-533",
              "sourceLine": 533
            }
          ]
        }
      ]
    },
