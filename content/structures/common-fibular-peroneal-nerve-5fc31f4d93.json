      "preferredVariantId": "v-429cb57dab",
      "variants": [
        {
          "id": "v-429cb57dab",
          "answer": "L4–S2; posterior divisions through sciatic nerve.",
          "sources": [
            {
              "modelId": "lower-limb-model-ns10",
              "cardId": "lower-limb-model-ns10-480",
