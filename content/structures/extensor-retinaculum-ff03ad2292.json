    },
    {
      "id": "f-f1e410ad14",
      "question": "Function",
      "preferredVariantId": "v-2cb16241c9",
      "variants": [
        {
          "id": "v-2cb16241c9",
          "answer": "Holds extensor tendons close to the wrist and prevents bowstringing during extension.",
          "sources": [
            {
              "modelId": "hand-model-ns13",
              "cardId": "hand-model-ns13-6",
              "sourceLine": 6
            }
          ]
        },
        {
          "id": "v-0b10a1be9b",
          "answer": "Prevents bowstringing of extensor tendons at the wrist.",
          "sources": [
            {
              "modelId": "upper-limb-model-ns15",
              "cardId": "upper-limb-model-ns15-163",
              "sourceLine": 163
            }
          ]
        }
      ],
      "editorialReview": {
        "date": "2026-09-11",
        "basis": "Reviewed supplied source answers; selected or synthesised concise revision wording."
      }
    },
    {
      "id": "f-f5cbdf6bfb",
      "question": "Contents",
      "preferredVariantId": "v-df4997b5cf",
      "variants": [
        {
          "id": "v-df4997b5cf",
          "answer": "Forms six dorsal osteofibrous compartments for the extensor tendons at the wrist.",
          "sources": [
            {
              "modelId": "hand-model-ns13",
              "cardId": "hand-model-ns13-7",
              "sourceLine": 7
            }
          ]
        }
      ]
    },
    {
      "id": "f-b03737e3cd",
      "question": "Clinical relevance",
      "preferredVariantId": "v-9b179e8d6d",
      "variants": [
        {
          "id": "v-9b179e8d6d",
          "answer": "Tenosynovitis may occur in specific compartments, such as de Quervain tenosynovitis in the first dorsal compartment.",
          "sources": [
            {
              "modelId": "hand-model-ns13",
              "cardId": "hand-model-ns13-8",
              "sourceLine": 8
            }
          ]
        },
        {
          "id": "v-b132111e0b",
          "answer": "Tendon-compartment inflammation beneath it includes conditions such as de Quervain tenosynovitis in the first compartment.",
          "sources": [
            {
              "modelId": "upper-limb-model-ns15",
              "cardId": "upper-limb-model-ns15-166",
              "sourceLine": 166
            }
          ]
        }
      ],
      "editorialReview": {
        "date": "2026-09-11",
        "basis": "Reviewed supplied source answers; selected or synthesised concise revision wording."
      }
    },
    {
