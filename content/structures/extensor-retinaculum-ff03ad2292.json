      "question": "Attachments",
      "preferredVariantId": "v-aaffc9a9d1",
      "variants": [
        {
          "id": "v-aaffc9a9d1",
          "answer": "Attaches laterally to distal radius and medially to styloid process of ulna, triquetrum and pisiform region.",
          "sources": [
            {
              "modelId": "hand-model-ns13",
              "cardId": "hand-model-ns13-5",
              "sourceLine": 5
            }
          ]
        },
        {
          "id": "v-686801b332",
          "answer": "Extends obliquely across the dorsal wrist from distal radius to ulnar-sided carpal and forearm fascia.",
          "sources": [
            {
              "modelId": "upper-limb-model-ns15",
              "cardId": "upper-limb-model-ns15-162",
              "sourceLine": 162
            }
          ]
        }
      ],
      "editorialReview": {
