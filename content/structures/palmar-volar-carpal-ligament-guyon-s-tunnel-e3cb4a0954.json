      "question": "Function",
      "preferredVariantId": "v-6089d9c493",
      "variants": [
        {
          "id": "v-6089d9c493",
          "answer": "The palmar carpal ligament helps retain superficial flexor structures; Guyon’s canal provides a passage for the ulnar neurovascular bundle.",
          "sources": [
            {
              "modelId": "upper-limb-model-ns15",
              "cardId": "upper-limb-model-ns15-158",
              "sourceLine": 158
            }
          ]
        }
      ]
    },
    {
