      "question": "Clinical relevance",
      "preferredVariantId": "v-18a0629fef",
      "variants": [
        {
          "id": "v-18a0629fef",
          "answer": "Ulnar nerve compression in Guyon’s canal causes ulnar-sided hand sensory and/or intrinsic motor deficits depending on lesion level.",
