      "question": "Roots",
      "preferredVariantId": "v-4e87fed952",
      "variants": [
        {
          "id": "v-75e1ae90dc",
          "answer": "C8–T1, terminal branch of the medial cord of the brachial plexus.",
          "sources": [
            {
              "modelId": "hand-model-ns13",
              "cardId": "hand-model-ns13-223",
              "sourceLine": 223
            }
          ]
        },
        {
          "id": "v-4e87fed952",
          "answer": "C8–T1, with occasional C7 contribution; terminal branch of medial cord.",
          "sources": [
            {
              "modelId": "upper-limb-model-ns15",
              "cardId": "upper-limb-model-ns15-471",
              "sourceLine": 471
            }
          ]
        },
        {
