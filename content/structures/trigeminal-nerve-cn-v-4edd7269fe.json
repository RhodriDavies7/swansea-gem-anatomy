      "question": "Course",
      "preferredVariantId": "v-ede8dafa5b",
      "variants": [
        {
          "id": "v-ede8dafa5b",
          "answer": "Sensory root expands into trigeminal ganglion; divisions V1, V2 and V3 leave via superior orbital fissure, foramen rotundum and foramen ovale respectively.",
          "sources": [
            {
              "modelId": "cranial-floor-model-bs1",
              "cardId": "cranial-floor-model-bs1-174",
              "sourceLine": 174
            }
          ]
        },
        {
          "id": "v-29b703d268",
          "answer": "Sensory root reaches trigeminal ganglion; divisions V1, V2 and V3 leave through superior orbital fissure, foramen rotundum and foramen ovale respectively.",
          "sources": [
            {
              "modelId": "head-and-neck-model-cs17-2",
              "cardId": "head-and-neck-model-cs17-2-767",
              "sourceLine": 767
            }
          ]
        },
        {
          "id": "v-804e5719c1",
          "answer": "Sensory root expands into the trigeminal ganglion; V1, V2 and V3 then leave the cranial cavity by different foramina.",
          "sources": [
            {
              "modelId": "deep-face-model-bs8-1",
              "cardId": "deep-face-model-bs8-1-151",
              "sourceLine": 151
            }
          ]
        }
      ],
