        {
          "id": "v-25dc5fb771",
          "answer": "Major attachment site for gluteus medius/minimus, piriformis, obturator internus and gemelli.",
          "sources": [
            {
              "modelId": "hip-joint-model-ns20",
              "cardId": "hip-joint-model-ns20-32",
              "sourceLine": 32
            }
          ]
        },
        {
          "id": "v-ba0e028a80",
          "answer": "Gluteus medius laterally, minimus anteriorly, piriformis superiorly, obturator internus/gemelli medially; obturator externus inserts into trochanteric fossa. Vastus lateralis arises partly from it.",
          "sources": [
            {
              "modelId": "lower-limb-model-ns10",
              "cardId": "lower-limb-model-ns10-560",
              "sourceLine": 560
            }
          ]
