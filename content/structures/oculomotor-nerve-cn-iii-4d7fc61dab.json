      "question": "Roots",
      "preferredVariantId": "v-8013d36680",
      "variants": [
        {
          "id": "v-8013d36680",
          "answer": "Midbrain nuclei at the level of the superior colliculus; somatic motor and parasympathetic fibres.",
          "sources": [
            {
              "modelId": "cranial-floor-model-bs1",
              "cardId": "cranial-floor-model-bs1-158",
              "sourceLine": 158
            }
          ]
        },
        {
          "id": "v-cc07fab0d6",
          "answer": "Arises from oculomotor nuclear complex in the midbrain at the level of the superior colliculus.",
          "sources": [
            {
              "modelId": "head-and-neck-model-cs17-2",
              "cardId": "head-and-neck-model-cs17-2-750",
              "sourceLine": 750
            }
          ]
        }
      ],
