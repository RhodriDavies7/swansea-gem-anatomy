    {
      "id": "f-d82b56cad9",
      "question": "Course",
      "preferredVariantId": "v-61e354a322",
      "variants": [
        {
          "id": "v-61e354a322",
          "answer": "Emerges from ventral midbrain, passes between posterior cerebral and superior cerebellar arteries, travels in cavernous sinus wall and enters orbit via superior orbital fissure.",
          "sources": [
            {
              "modelId": "cranial-floor-model-bs1",
              "cardId": "cranial-floor-model-bs1-159",
              "sourceLine": 159
            }
          ]
        },
        {
          "id": "v-e0e152d314",
          "answer": "Emerges from ventral midbrain, passes through cavernous sinus and superior orbital fissure.",
          "sources": [
            {
              "modelId": "head-and-neck-model-cs17-2",
              "cardId": "head-and-neck-model-cs17-2-751",
              "sourceLine": 751
            }
          ]
        }
      ],
      "editorialReview": {
        "date": "2026-09-11",
        "basis": "Reviewed supplied source answers; selected or synthesised concise revision wording."
      }
    },
    {
      "id": "f-c8b6915183",
      "question": "Motor functions",
      "preferredVariantId": "v-0f87b9f336",
      "variants": [
        {
          "id": "v-0f87b9f336",
          "answer": "Supplies superior, medial and inferior recti, inferior oblique and levator palpebrae superioris; parasympathetic fibres constrict pupil and accommodate.",
          "sources": [
            {
              "modelId": "cranial-floor-model-bs1",
              "cardId": "cranial-floor-model-bs1-160",
              "sourceLine": 160
            }
          ]
        },
        {
          "id": "v-06c19ddde0",
          "answer": "Supplies superior, inferior and medial recti, inferior oblique and levator palpebrae; carries parasympathetic fibres to sphincter pupillae and ciliary muscle.",
          "sources": [
            {
              "modelId": "head-and-neck-model-cs17-2",
              "cardId": "head-and-neck-model-cs17-2-752",
              "sourceLine": 752
            }
          ]
        }
      ],
      "editorialReview": {
        "date": "2026-09-11",
        "basis": "Reviewed supplied source answers; selected or synthesised concise revision wording."
      }
    },
    {
      "id": "f-bc53d10c57",
      "question": "Lesion",
      "preferredVariantId": "v-ffdc7a0bd0",
      "variants": [
        {
          "id": "v-ffdc7a0bd0",
          "answer": "Ptosis, 'down and out' eye, diplopia and possibly a dilated poorly reactive pupil.",
          "sources": [
            {
              "modelId": "cranial-floor-model-bs1",
              "cardId": "cranial-floor-model-bs1-161",
              "sourceLine": 161
            }
          ]
        },
        {
          "id": "v-ec8bf9c666",
          "answer": "Causes ptosis, a 'down and out' eye, diplopia and often a dilated pupil with loss of accommodation.",
          "sources": [
            {
              "modelId": "head-and-neck-model-cs17-2",
              "cardId": "head-and-neck-model-cs17-2-754",
              "sourceLine": 754
            }
          ]
        },
        {
          "id": "v-0e6f25e027",
          "answer": "Ptosis, 'down and out' eye, diplopia and a dilated poorly reactive pupil if parasympathetic fibres are involved.",
          "sources": [
            {
              "modelId": "male-torso-with-head-model-as23-1",
              "cardId": "male-torso-with-head-model-as23-1-233"
            }
          ]
        }
      ],
      "editorialReview": {
