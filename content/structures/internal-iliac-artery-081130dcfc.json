    {
      "id": "f-f578227926",
      "question": "Branches",
      "preferredVariantId": "v-dc6788922e",
      "variants": [
        {
          "id": "v-4010b10271",
          "answer": "Posterior division gives iliolumbar, lateral sacral and superior gluteal arteries; anterior division gives pelvic visceral and perineal branches including uterine, vaginal, obturator, internal pudendal and inferior gluteal arteries.",
          "sources": [
            {
              "modelId": "female-reproductive-system-model-ms1",
              "cardId": "female-reproductive-system-model-ms1-177",
              "sourceLine": 177
            }
          ]
        },
        {
          "id": "v-dc6788922e",
          "answer": "Posterior division: iliolumbar, lateral sacral, superior gluteal. Anterior division commonly gives obturator, inferior gluteal, internal pudendal, umbilical/superior vesical, middle rectal and sex-dependent visceral branches.",
          "sources": [
            {
              "modelId": "lower-limb-model-ns10",
              "cardId": "lower-limb-model-ns10-318",
              "sourceLine": 318
            }
          ]
        }
      ],
      "editorialReview": {
