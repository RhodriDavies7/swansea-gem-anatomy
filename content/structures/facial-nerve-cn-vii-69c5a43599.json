      "question": "Roots",
      "preferredVariantId": "curated-20d3756adc",
      "variants": [
        {
          "id": "v-06844bc778",
          "answer": "Motor nucleus of facial nerve in pons, with sensory/parasympathetic fibres travelling in nervus intermedius.",
