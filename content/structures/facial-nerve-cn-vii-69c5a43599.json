            {
              "modelId": "cranial-floor-model-bs1",
              "cardId": "cranial-floor-model-bs1-223",
              "sourceLine": 223
            }
          ]
        },
        {
          "id": "v-f02b978e43",
          "answer": "Motor root and nervus intermedius emerge at pontomedullary junction.",
          "sources": [
            {
              "modelId": "head-and-neck-model-cs17-2",
              "cardId": "head-and-neck-model-cs17-2-782",
              "sourceLine": 782
            }
          ]
        },
        {
          "id": "curated-20d3756adc",
          "answer": "Motor nucleus in the pons. The motor root and nervus intermedius (sensory and parasympathetic fibres) emerge at the pontomedullary junction.",
