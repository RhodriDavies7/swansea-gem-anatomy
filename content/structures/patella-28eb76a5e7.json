    },
    {
      "id": "f-2389607e0b",
      "question": "Muscle attachments",
      "preferredVariantId": "v-f89a358afe",
      "variants": [
        {
          "id": "v-f89a358afe",
          "answer": "Quadriceps tendon attaches to base and margins; force is transmitted from apex to tibial tuberosity by patellar ligament; patellar retinacula attach at sides.",
          "sources": [
            {
              "modelId": "lower-limb-model-ns10",
              "cardId": "lower-limb-model-ns10-591",
              "sourceLine": 591
            }
          ]
        }
      ]
    },
