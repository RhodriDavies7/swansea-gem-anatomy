      "variants": [
        {
          "id": "v-553925d589",
          "answer": "Articulates posteriorly with the patellar surface of the femur.",
          "sources": [
            {
              "modelId": "knee-joint-model-ns19",
              "cardId": "knee-joint-model-ns19-10",
              "sourceLine": 10
            }
          ]
        },
        {
          "id": "v-fe2aa6bab0",
          "answer": "Posterior surface articulates with femoral trochlea; no direct tibial articulation.",
          "sources": [
            {
              "modelId": "lower-limb-model-ns10",
              "cardId": "lower-limb-model-ns10-589",
              "sourceLine": 589
            }
          ]
