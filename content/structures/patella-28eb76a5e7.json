    },
    {
      "id": "f-f1e410ad14",
      "question": "Function",
      "preferredVariantId": "v-34b2aaa83e",
      "variants": [
        {
          "id": "v-34b2aaa83e",
          "answer": "Increases the moment arm of quadriceps and protects the anterior knee joint.",
          "sources": [
            {
              "modelId": "knee-joint-model-ns19",
              "cardId": "knee-joint-model-ns19-12",
              "sourceLine": 12
            }
          ]
        }
      ]
    },
    {
      "id": "f-6771ade6e8",
      "question": "Attachments",
      "preferredVariantId": "v-29d3127b2c",
      "variants": [
        {
          "id": "v-29d3127b2c",
          "answer": "Quadriceps tendon attaches superiorly and patellar ligament inferiorly.",
          "sources": [
            {
              "modelId": "knee-joint-model-ns19",
              "cardId": "knee-joint-model-ns19-13",
              "sourceLine": 13
            }
