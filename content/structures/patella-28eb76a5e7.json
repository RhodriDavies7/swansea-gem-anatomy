    },
    {
      "id": "f-626b6c1d45",
      "question": "Landmarks",
      "preferredVariantId": "v-113a7400c0",
      "variants": [
        {
          "id": "v-113a7400c0",
          "answer": "Superior base, inferior apex, anterior surface and posterior medial/lateral articular facets separated by vertical ridge.",
