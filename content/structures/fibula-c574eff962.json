      "variants": [
        {
          "id": "v-595c9cea1a",
          "answer": "Articulates with tibia proximally and distally; lateral malleolus articulates with talus.",
          "sources": [
            {
              "modelId": "foot-model-ns9",
              "cardId": "foot-model-ns9-17",
              "sourceLine": 17
            }
          ]
        },
        {
          "id": "v-5443633f8d",
          "answer": "Tibia at proximal tibiofibular joint and distal syndesmosis; talus at lateral malleolar facet. Does not articulate with femur.",
          "sources": [
            {
              "modelId": "lower-limb-model-ns10",
              "cardId": "lower-limb-model-ns10-613",
              "sourceLine": 613
            }
          ]
        }
      ],
