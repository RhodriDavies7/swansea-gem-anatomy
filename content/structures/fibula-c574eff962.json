    {
      "id": "f-86e4e38754",
      "question": "Orientation",
      "preferredVariantId": "v-f02e2eabb3",
      "variants": [
        {
          "id": "v-e5bd93310d",
          "answer": "Lateral malleolus projects more distally and posteriorly than the medial malleolus.",
          "sources": [
            {
              "modelId": "foot-model-ns9",
              "cardId": "foot-model-ns9-19",
              "sourceLine": 19
            }
          ]
        },
        {
          "id": "v-f02e2eabb3",
          "answer": "Head superior; lateral malleolus inferior; malleolar articular facet faces medially and malleolar fossa posteriorly. Distal malleolus extends lower than tibial malleolus.",
