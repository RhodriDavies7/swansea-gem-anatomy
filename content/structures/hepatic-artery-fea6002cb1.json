      "question": "Origin",
      "preferredVariantId": "v-f52f8fa1de",
      "variants": [
        {
          "id": "v-54bf624a41",
          "answer": "Proper hepatic artery is a branch of the common hepatic artery from the coeliac trunk.",
          "sources": [
            {
              "modelId": "liver-js5",
              "cardId": "liver-js5-83",
              "sourceLine": 83
            }
          ]
        },
        {
          "id": "v-f52f8fa1de",
          "answer": "Common hepatic artery is a branch of the coeliac trunk; proper hepatic artery continues after giving the gastroduodenal artery.",
          "sources": [
            {
              "modelId": "pancreas-model-js11",
              "cardId": "pancreas-model-js11-82",
              "sourceLine": 82
            }
          ]
        }
      ],
