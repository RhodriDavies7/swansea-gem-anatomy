            {
              "modelId": "cranial-floor-model-bs1",
              "cardId": "cranial-floor-model-bs1-102",
              "sourceLine": 102
            }
          ]
        },
        {
          "id": "v-20b66f7277",
          "answer": "Ascends through cervical transverse foramina and enters the skull through the foramen magnum.",
          "sources": [
            {
              "modelId": "thorax-model-hs21",
              "cardId": "thorax-model-hs21-548"
            }
          ]
        },
        {
          "id": "v-9cf90675aa",
          "answer": "Ascends through transverse foramina and enters skull via foramen magnum.",
