            {
              "modelId": "hand-model-ns13",
              "cardId": "hand-model-ns13-25",
              "sourceLine": 25
            }
          ]
        }
      ]
    },
    {
      "id": "f-6519fe11ef",
      "question": "Relations",
      "preferredVariantId": "v-6263e08bb7",
      "variants": [
        {
          "id": "v-6263e08bb7",
          "answer": "Sesamoid bone within the flexor carpi ulnaris tendon on the palmar ulnar side of the wrist.",
          "sources": [
            {
              "modelId": "hand-model-ns13",
              "cardId": "hand-model-ns13-26",
