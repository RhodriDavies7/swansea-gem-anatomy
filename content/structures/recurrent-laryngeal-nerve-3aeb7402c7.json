      "question": "Course",
      "preferredVariantId": "v-a4c8e44521",
      "variants": [
        {
          "id": "v-a4c8e44521",
          "answer": "Right loops under the subclavian artery; left loops under the aortic arch near the ligamentum arteriosum; both ascend in the tracheo-oesophageal groove and enter the larynx as inferior laryngeal nerves.",
          "sources": [
            {
              "modelId": "larynx-model-gs7",
              "cardId": "larynx-model-gs7-218",
              "sourceLine": 218
            },
            {
              "modelId": "larynx-and-airway-model-gs5",
              "cardId": "larynx-and-airway-model-gs5-218",
              "sourceLine": 218
            }
          ]
        },
        {
          "id": "v-07b0e4e842",
          "answer": "Right loops under the subclavian artery; left loops under the aortic arch near the ligamentum arteriosum; both ascend in the tracheo-oesophageal groove.",
          "sources": [
            {
              "modelId": "thorax-model-hs21",
              "cardId": "thorax-model-hs21-673"
            }
          ]
        }
      ]
    },
    {
