            {
              "modelId": "upper-limb-model-ns15",
              "cardId": "upper-limb-model-ns15-489",
              "sourceLine": 489
            }
          ]
        },
        {
          "id": "v-d9093a2297",
          "answer": "Causes sensory loss or paraesthesia over the dorsomedial hand and dorsal medial 1½ digits without intrinsic hand weakness if the branch alone is affected.",
          "sources": [
            {
              "modelId": "hand-model-ns13",
              "cardId": "hand-model-ns13-239",
              "sourceLine": 239
            }
          ]
        }
