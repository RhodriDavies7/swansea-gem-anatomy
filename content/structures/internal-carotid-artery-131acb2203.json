    {
      "id": "f-d82b56cad9",
      "question": "Course",
      "preferredVariantId": "curated-6515364eaa",
      "variants": [
        {
          "id": "v-54b54b6a07",
          "answer": "Enters the carotid canal, traverses the petrous temporal bone, passes through the cavernous sinus region, then enters the subarachnoid space.",
          "sources": [
            {
              "modelId": "cranial-floor-model-bs1",
              "cardId": "cranial-floor-model-bs1-46",
              "sourceLine": 46
            }
          ]
        },
        {
          "id": "v-98e498c087",
          "answer": "Ascends in carotid sheath without branching in the neck, enters carotid canal and continues intracranially.",
          "sources": [
            {
              "modelId": "deep-face-model-bs8-1",
              "cardId": "deep-face-model-bs8-1-130",
              "sourceLine": 130
            }
          ]
        },
        {
          "id": "v-76506f6059",
          "answer": "Enters the carotid canal in the petrous temporal bone, turns anteromedially, then continues toward the cavernous sinus.",
          "sources": [
            {
              "modelId": "ear-largest-model-ds1",
              "cardId": "ear-largest-model-ds1-86",
              "sourceLine": 86
            }
          ]
        },
        {
          "id": "v-b8af01b7de",
          "answer": "Traverses the carotid canal in the petrous temporal bone before entering the cavernous region.",
          "sources": [
            {
              "modelId": "ear-largest-model-ds1",
              "cardId": "ear-largest-model-ds1-114",
              "sourceLine": 114
            }
          ]
        },
        {
          "id": "v-3dd78adf2b",
          "answer": "Ascends in carotid sheath without branching in neck, enters carotid canal and continues intracranially.",
          "sources": [
            {
              "modelId": "half-head-and-neck-model-bs9",
              "cardId": "half-head-and-neck-model-bs9-646",
              "sourceLine": 646
            }
          ]
        },
        {
          "id": "v-e755374382",
          "answer": "Ascends in carotid sheath without branches in neck and enters carotid canal.",
          "sources": [
            {
              "modelId": "head-and-neck-model-cs17-2",
              "cardId": "head-and-neck-model-cs17-2-402",
              "sourceLine": 402
            }
          ]
        },
        {
          "id": "curated-6515364eaa",
          "answer": "Ascends in the carotid sheath without neck branches; enters the carotid canal, traverses the petrous temporal bone and cavernous sinus, then enters the subarachnoid space.",
          "sources": [
            {
              "modelId": "cranial-floor-model-bs1",
              "cardId": "cranial-floor-model-bs1-46",
              "sourceLine": 46
