    {
      "id": "f-6519fe11ef",
      "question": "Relations",
      "preferredVariantId": "curated-7bc30d78fb",
      "variants": [
        {
          "id": "v-ea1b5607b3",
          "answer": "Lies posterolateral to the external carotid near the bifurcation before ascending deep in the neck.",
          "sources": [
            {
              "modelId": "deep-face-model-bs8-1",
              "cardId": "deep-face-model-bs8-1-132",
              "sourceLine": 132
            }
          ]
        },
        {
          "id": "v-f1e0097411",
          "answer": "Closely related to the petrous temporal bone and middle ear region within the carotid canal.",
          "sources": [
            {
              "modelId": "ear-largest-model-ds1",
              "cardId": "ear-largest-model-ds1-88",
              "sourceLine": 88
            }
          ]
        },
        {
          "id": "v-4bb4f85923",
          "answer": "The petrous internal carotid lies anterior to the middle ear and inner ear structures.",
          "sources": [
            {
              "modelId": "ear-largest-model-ds1",
              "cardId": "ear-largest-model-ds1-116",
              "sourceLine": 116
            }
          ]
        },
        {
          "id": "curated-7bc30d78fb",
          "answer": "Near the carotid bifurcation, lies posterolateral to the external carotid artery. Its petrous segment lies anterior to the middle ear.",
