    {
      "id": "f-2389607e0b",
      "question": "Muscle attachments",
      "preferredVariantId": "v-85aa8b2367",
      "variants": [
        {
          "id": "v-85aa8b2367",
          "answer": "Trochanters receive gluteal/short rotator/iliopsoas attachments; linea aspera receives adductors and origins of vasti/short biceps head; gastrocnemius and popliteus arise distally.",
          "sources": [
            {
              "modelId": "lower-limb-model-ns10",
              "cardId": "lower-limb-model-ns10-573",
              "sourceLine": 573
            }
          ]
        }
      ]
    },
    {
      "id": "f-86e4e38754",
      "question": "Orientation",
      "preferredVariantId": "v-0deaec5274",
      "variants": [
        {
          "id": "v-0deaec5274",
          "answer": "Head points medially and slightly anteriorly; linea aspera and intercondylar fossa face posteriorly; patellar surface faces anteriorly. Position head toward the body midline to determine side.",
          "sources": [
            {
              "modelId": "lower-limb-model-ns10",
              "cardId": "lower-limb-model-ns10-574",
              "sourceLine": 574
            }
          ]
