      "question": "Function",
      "preferredVariantId": "v-a1f984d484",
      "variants": [
        {
          "id": "v-a1f984d484",
          "answer": "Transmits body weight and acts as the major lever of the thigh.",
          "sources": [
            {
              "modelId": "hip-joint-model-ns20",
              "cardId": "hip-joint-model-ns20-23",
              "sourceLine": 23
            }
          ]
        },
        {
          "id": "v-eddc84ca92",
          "answer": "Transmits body weight from hip to knee and provides attachment for major knee ligaments and muscles.",
          "sources": [
            {
              "modelId": "knee-joint-model-ns19",
              "cardId": "knee-joint-model-ns19-6",
              "sourceLine": 6
            }
          ]
        }
      ],
