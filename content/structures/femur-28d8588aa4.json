      "question": "Articulations",
      "preferredVariantId": "v-a9f58df149",
      "variants": [
        {
          "id": "v-a9f58df149",
          "answer": "Articulates proximally with acetabulum and distally with tibia and patella.",
          "sources": [
            {
              "modelId": "hip-joint-model-ns20",
              "cardId": "hip-joint-model-ns20-22",
              "sourceLine": 22
            }
          ]
        },
        {
          "id": "v-75c7ffb296",
          "answer": "Distally articulates with tibia and patella at the knee joint.",
          "sources": [
            {
              "modelId": "knee-joint-model-ns19",
              "cardId": "knee-joint-model-ns19-4",
              "sourceLine": 4
            }
          ]
        },
        {
          "id": "v-ce0ac56450",
          "answer": "Acetabulum at hip; tibia and patella at knee.",
          "sources": [
            {
              "modelId": "lower-limb-model-ns10",
              "cardId": "lower-limb-model-ns10-571",
              "sourceLine": 571
            }
          ]
        }
