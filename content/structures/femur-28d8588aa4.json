    {
      "id": "f-626b6c1d45",
      "question": "Landmarks",
      "preferredVariantId": "v-5a44dab96c",
      "variants": [
        {
          "id": "v-2017e5802d",
          "answer": "Medial and lateral condyles, medial and lateral epicondyles, intercondylar fossa and patellar surface.",
          "sources": [
            {
              "modelId": "knee-joint-model-ns19",
              "cardId": "knee-joint-model-ns19-5",
              "sourceLine": 5
            }
          ]
        },
        {
          "id": "v-5a44dab96c",
          "answer": "Head and fovea, neck, greater/lesser trochanters, intertrochanteric line/crest, gluteal tuberosity, linea aspera, condyles, epicondyles, adductor tubercle and intercondylar fossa.",
          "sources": [
            {
              "modelId": "lower-limb-model-ns10",
              "cardId": "lower-limb-model-ns10-572",
              "sourceLine": 572
            }
          ]
