      "question": "Course",
      "preferredVariantId": "v-8e2d09a239",
      "variants": [
        {
          "id": "v-b1b3003fca",
          "answer": "Emerges from postolivary sulcus and exits skull through jugular foramen.",
          "sources": [
            {
              "modelId": "cranial-floor-model-bs1",
              "cardId": "cranial-floor-model-bs1-239",
              "sourceLine": 239
            }
          ]
        },
        {
          "id": "v-8e2d09a239",
          "answer": "Exits skull via jugular foramen and descends between internal carotid artery and internal jugular vein toward pharynx/tongue.",
          "sources": [
            {
              "modelId": "head-and-neck-model-cs17-2",
              "cardId": "head-and-neck-model-cs17-2-799",
              "sourceLine": 799
            }
          ]
        },
        {
          "id": "v-8ab9b188b9",
          "answer": "Exits via jugular foramen and passes toward pharynx and posterior tongue.",
          "sources": [
            {
              "modelId": "larynx-and-tongue-model-gs4",
              "cardId": "larynx-and-tongue-model-gs4-264",
              "sourceLine": 264
