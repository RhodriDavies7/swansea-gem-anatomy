    {
      "id": "f-9f76a2a9d2",
      "question": "Parasympathetic functions",
      "preferredVariantId": "v-6275e1d1c3",
      "variants": [
        {
          "id": "v-6275e1d1c3",
          "answer": "Carries preganglionic fibres to the submandibular ganglion for submandibular and sublingual glands.",
          "sources": [
            {
              "modelId": "ear-largest-model-ds1",
              "cardId": "ear-largest-model-ds1-186",
              "sourceLine": 186
            },
            {
              "modelId": "ear-model-ds3",
              "cardId": "ear-model-ds3-88",
