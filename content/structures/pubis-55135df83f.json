      "question": "Muscle attachments",
      "preferredVariantId": "v-37d8010295",
      "variants": [
        {
          "id": "v-37d8010295",
          "answer": "Pectineus on superior ramus; adductor longus on body; adductor brevis, gracilis and adductor magnus on body/inferior ramus; rectus abdominis on crest/symphysis; obturator muscles around obturator foramen.",
          "sources": [
            {
              "modelId": "lower-limb-model-ns10",
              "cardId": "lower-limb-model-ns10-535",
              "sourceLine": 535
            }
          ]
        },
        {
          "id": "v-3996054970",
          "answer": "Pectineus, adductor longus, adductor brevis, gracilis and part of adductor magnus attach to the pubis; rectus abdominis attaches near the pubic crest/symphysis.",
          "sources": [
            {
              "modelId": "female-reproductive-system-model-ms1",
              "cardId": "female-reproductive-system-model-ms1-5",
