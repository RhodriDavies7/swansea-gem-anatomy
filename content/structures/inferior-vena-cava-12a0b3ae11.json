    {
      "id": "f-d82b56cad9",
      "question": "Course",
      "preferredVariantId": "curated-c094d6b58b",
      "variants": [
        {
          "id": "v-31cf9e3278",
          "answer": "Ascends on the right side of the vertebral column.",
          "sources": [
            {
              "modelId": "female-pelvis-model-mo8",
              "cardId": "female-pelvis-model-mo8-290",
              "sourceLine": 290
            }
          ]
        },
        {
          "id": "v-1b866462df",
          "answer": "Ascends through the diaphragm at T8 and enters the inferior aspect of the right atrium.",
          "sources": [
            {
              "modelId": "heart-model-hs5",
              "cardId": "heart-model-hs5-67",
              "sourceLine": 67
            }
          ]
        },
        {
          "id": "v-750ba8be73",
          "answer": "Ascends on the right side of the vertebral column and runs in a groove on the posterior liver before passing through the diaphragm.",
          "sources": [
            {
              "modelId": "liver-js5",
              "cardId": "liver-js5-98",
              "sourceLine": 98
            }
          ]
        },
        {
          "id": "v-3a7b775f2d",
          "answer": "Passes through diaphragm at T8 and enters right atrium.",
          "sources": [
            {
              "modelId": "lungs-with-heart-diaphragm-larynx-model-mh9",
              "cardId": "lungs-with-heart-diaphragm-larynx-model-mh9-172",
              "sourceLine": 172
            }
          ]
        },
        {
          "id": "v-a8726de1f3",
          "answer": "Ascends to the right of the abdominal aorta and passes through the diaphragm at T8.",
          "sources": [
            {
              "modelId": "urinary-system-model-ls3-1",
              "cardId": "urinary-system-model-ls3-1-94",
              "sourceLine": 94
            }
          ]
        },
        {
          "id": "curated-c094d6b58b",
          "answer": "Ascends to the right of the abdominal aorta, grooves the posterior liver and passes through the diaphragm at T8 to enter the right atrium.",
          "sources": [
            {
              "modelId": "female-pelvis-model-mo8",
              "cardId": "female-pelvis-model-mo8-290",
              "sourceLine": 290
            },
            {
