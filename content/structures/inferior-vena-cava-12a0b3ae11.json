    {
      "id": "f-74a64b1943",
      "question": "Drainage",
      "preferredVariantId": "curated-b3648a8483",
      "variants": [
        {
          "id": "v-0fb0786517",
          "answer": "Returns venous blood from lower limbs, pelvis and abdomen to the right atrium.",
          "sources": [
            {
              "modelId": "female-pelvis-model-mo8",
              "cardId": "female-pelvis-model-mo8-291",
              "sourceLine": 291
            }
          ]
        },
        {
          "id": "v-4a45316979",
          "answer": "Returns venous blood from structures below the diaphragm.",
          "sources": [
            {
              "modelId": "heart-model-hs5",
              "cardId": "heart-model-hs5-68",
              "sourceLine": 68
            },
            {
              "modelId": "lungs-with-heart-diaphragm-larynx-model-mh9",
