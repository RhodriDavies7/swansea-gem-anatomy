              "sourceLine": 173
            }
          ]
        },
        {
          "id": "v-0f1dfb6e3b",
          "answer": "Receives hepatic veins draining blood from the liver.",
          "sources": [
            {
              "modelId": "liver-js5",
              "cardId": "liver-js5-99",
              "sourceLine": 99
            }
          ]
        },
        {
          "id": "v-194ab2aca4",
          "answer": "Receives renal veins and returns systemic venous blood to the right atrium.",
          "sources": [
            {
              "modelId": "urinary-system-model-ls3-1",
              "cardId": "urinary-system-model-ls3-1-95",
              "sourceLine": 95
            }
          ]
        },
        {
          "id": "curated-b3648a8483",
          "answer": "Returns venous blood from below the diaphragm to the right atrium, including blood from the lower limbs, pelvis, kidneys and liver.",
