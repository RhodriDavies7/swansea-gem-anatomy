    {
      "id": "f-d82b56cad9",
      "question": "Course",
      "preferredVariantId": "v-9026cc2591",
      "variants": [
        {
          "id": "v-9026cc2591",
          "answer": "Lies on anterior surface of piriformis on posterior pelvic wall; many branches leave via greater sciatic foramen.",
          "sources": [
            {
              "modelId": "lower-limb-model-ns10",
              "cardId": "lower-limb-model-ns10-460",
              "sourceLine": 460
            }
          ]
        }
      ]
    },
    {
      "id": "f-c8b6915183",
      "question": "Motor functions",
      "preferredVariantId": "v-e5dde1f58c",
      "variants": [
        {
          "id": "v-e5dde1f58c",
          "answer": "Via branches: gluteal muscles, short hip rotators, hamstrings, most of adductor magnus hamstring part, all leg and foot muscles, and perineal muscles.",
          "sources": [
            {
              "modelId": "lower-limb-model-ns10",
              "cardId": "lower-limb-model-ns10-461",
              "sourceLine": 461
            }
          ]
        }
      ]
    },
    {
      "id": "f-a453254382",
      "question": "Sensory functions",
      "preferredVariantId": "v-ba71a26866",
      "variants": [
        {
          "id": "v-ba71a26866",
          "answer": "Via branches: posterior thigh, most of leg and foot, and perineum; excludes femoral/saphenous and obturator territories.",
          "sources": [
            {
              "modelId": "lower-limb-model-ns10",
              "cardId": "lower-limb-model-ns10-462",
              "sourceLine": 462
            }
          ]
        }
      ]
    },
    {
      "id": "f-bc53d10c57",
      "question": "Lesion",
      "preferredVariantId": "v-cf53cc3a4b",
      "variants": [
        {
          "id": "v-cf53cc3a4b",
          "answer": "Deficits span several nerves: variable hip, knee, ankle and foot weakness with broad sensory loss; lower plexus involvement may affect perineal sensation and sphincter control.",
