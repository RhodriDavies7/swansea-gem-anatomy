            {
              "modelId": "hand-model-ns13",
              "cardId": "hand-model-ns13-19",
              "sourceLine": 19
            }
          ]
        },
        {
          "id": "v-3ebbb8ab32",
          "answer": "Head, neck, radial tuberosity, shaft, ulnar notch, dorsal tubercle and styloid process.",
