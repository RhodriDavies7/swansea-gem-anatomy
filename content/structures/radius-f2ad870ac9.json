    {
      "id": "f-2389607e0b",
      "question": "Muscle attachments",
      "preferredVariantId": "v-e068aabdee",
      "variants": [
        {
          "id": "v-fd2c39b7e5",
          "answer": "Biceps brachii inserts on radial tuberosity; supinator wraps around proximal radius; pronator teres inserts on lateral radius.",
          "sources": [
            {
              "modelId": "elbow-joint-model-ns18",
              "cardId": "elbow-joint-model-ns18-19",
              "sourceLine": 19
            }
          ]
        },
        {
          "id": "v-e068aabdee",
          "answer": "Biceps inserts on radial tuberosity; pronator teres and pronator quadratus insert on radius; supinator inserts proximally; multiple thumb muscles arise from shaft.",
          "sources": [
            {
              "modelId": "upper-limb-model-ns15",
              "cardId": "upper-limb-model-ns15-585",
              "sourceLine": 585
            }
          ]
        }
      ],
      "editorialReview": {
        "date": "2026-09-11",
        "basis": "Reviewed supplied source answers; selected or synthesised concise revision wording."
      }
    },
    {
      "id": "f-86e4e38754",
      "question": "Orientation",
      "preferredVariantId": "v-3615ed1cb7",
      "variants": [
        {
          "id": "v-7ba55cef17",
          "answer": "Radial head is proximal and disc-shaped; radial tuberosity lies medially.",
          "sources": [
            {
              "modelId": "elbow-joint-model-ns18",
              "cardId": "elbow-joint-model-ns18-20",
              "sourceLine": 20
            }
          ]
        },
        {
          "id": "v-6434ee9cbe",
          "answer": "Radial styloid lies laterally; dorsal tubercle lies posteriorly.",
          "sources": [
            {
              "modelId": "hand-model-ns13",
              "cardId": "hand-model-ns13-20",
              "sourceLine": 20
            }
          ]
        },
        {
          "id": "v-3615ed1cb7",
          "answer": "Disc-shaped head proximal; tuberosity faces medially; styloid distal/lateral; dorsal tubercle posterior.",
          "sources": [
