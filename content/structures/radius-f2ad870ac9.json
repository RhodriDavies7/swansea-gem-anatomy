      "question": "Articulations",
      "preferredVariantId": "v-eff568a398",
      "variants": [
        {
          "id": "v-eff568a398",
          "answer": "Articulates proximally with capitulum of humerus and radial notch of ulna; distally with scaphoid/lunate and ulna.",
          "sources": [
            {
              "modelId": "elbow-joint-model-ns18",
              "cardId": "elbow-joint-model-ns18-17",
              "sourceLine": 17
            }
          ]
        },
        {
          "id": "v-43bd90f706",
          "answer": "Articulates distally with scaphoid and lunate and with ulna at the distal radioulnar joint.",
          "sources": [
            {
              "modelId": "hand-model-ns13",
              "cardId": "hand-model-ns13-18",
              "sourceLine": 18
            }
          ]
        },
        {
          "id": "v-40061f8730",
          "answer": "Capitulum of humerus and ulna proximally; ulna and scaphoid/lunate distally.",
          "sources": [
            {
              "modelId": "upper-limb-model-ns15",
              "cardId": "upper-limb-model-ns15-583",
              "sourceLine": 583
            }
          ]
