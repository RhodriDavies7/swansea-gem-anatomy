    {
      "id": "f-a40bee8d10",
      "question": "Articulations",
      "preferredVariantId": "v-90c7bd11f4",
      "variants": [
        {
          "id": "v-6167e59d28",
          "answer": "Articulates distally with talus and fibula; proximally with femur and fibula.",
          "sources": [
            {
              "modelId": "foot-model-ns9",
              "cardId": "foot-model-ns9-5",
              "sourceLine": 5
            }
          ]
        },
        {
          "id": "v-9935e5bb07",
          "answer": "Proximally articulates with femoral condyles and fibular head.",
          "sources": [
            {
              "modelId": "knee-joint-model-ns19",
              "cardId": "knee-joint-model-ns19-17",
              "sourceLine": 17
            }
          ]
        },
        {
          "id": "v-90c7bd11f4",
          "answer": "Femur superiorly; fibula at proximal tibiofibular joint and distal syndesmosis; talus inferiorly.",
          "sources": [
            {
              "modelId": "lower-limb-model-ns10",
              "cardId": "lower-limb-model-ns10-595",
              "sourceLine": 595
            }
          ]
        }
      ],
      "editorialReview": {
