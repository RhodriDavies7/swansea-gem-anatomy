    {
      "id": "f-6519fe11ef",
      "question": "Relations",
      "preferredVariantId": "curated-001faa51ee",
      "variants": [
        {
          "id": "v-ab1731a30e",
          "answer": "Forms pelvic reflections including vesicouterine and rectouterine pouches.",
          "sources": [
            {
              "modelId": "female-pelvis-model-mo8",
              "cardId": "female-pelvis-model-mo8-317",
              "sourceLine": 317
            }
          ]
        },
        {
          "id": "v-2cde01a909",
          "answer": "In the female pelvis, reflects between bladder and uterus to form the vesicouterine pouch and between uterus and rectum to form the rectouterine pouch (pouch of Douglas).",
          "sources": [
            {
              "modelId": "female-reproductive-system-model-ms1",
              "cardId": "female-reproductive-system-model-ms1-193",
              "sourceLine": 193
            }
          ]
        },
        {
          "id": "v-b2b07f7347",
          "answer": "In the male pelvis, reflects from the bladder onto the rectum to form the rectovesical pouch.",
          "sources": [
            {
              "modelId": "male-reproductive-system-model-ms2",
              "cardId": "male-reproductive-system-model-ms2-215",
              "sourceLine": 215
            }
          ]
        },
        {
          "id": "curated-001faa51ee",
          "answer": "Female pelvis: vesicouterine pouch between bladder and uterus; rectouterine pouch (pouch of Douglas) between uterus and rectum. Male pelvis: rectovesical pouch between bladder and rectum.",
          "sources": [
            {
              "modelId": "female-pelvis-model-mo8",
              "cardId": "female-pelvis-model-mo8-317",
              "sourceLine": 317
            },
            {
              "modelId": "female-reproductive-system-model-ms1",
              "cardId": "female-reproductive-system-model-ms1-193",
              "sourceLine": 193
            },
            {
              "modelId": "male-reproductive-system-model-ms2",
              "cardId": "male-reproductive-system-model-ms2-215",
              "sourceLine": 215
            }
          ],
          "editorial": true
        }
      ],
      "editorialReview": {
        "date": "2026-09-11",
        "basis": "Reviewed supplied source answers; selected or synthesised concise revision wording."
      }
    },
    {
      "id": "f-65461dd593",
      "question": "Innervation",
      "preferredVariantId": "v-167a910e20",
      "variants": [
        {
          "id": "v-167a910e20",
          "answer": "Parietal peritoneum has somatic innervation and is pain-sensitive; visceral peritoneum carries visceral afferent fibres with autonomic nerves.",
          "sources": [
            {
              "modelId": "female-reproductive-system-model-ms1",
              "cardId": "female-reproductive-system-model-ms1-194",
              "sourceLine": 194
            }
          ]
        },
        {
          "id": "v-3cb589ac8a",
          "answer": "Parietal peritoneum has somatic innervation and is pain-sensitive; visceral peritoneum has autonomic visceral afferent innervation.",
          "sources": [
            {
              "modelId": "male-reproductive-system-model-ms2",
              "cardId": "male-reproductive-system-model-ms2-216",
              "sourceLine": 216
            }
          ]
        }
      ],
      "editorialReview": {
        "date": "2026-09-11",
        "basis": "Reviewed supplied source answers; selected or synthesised concise revision wording."
      }
    },
    {
      "id": "f-9482c5d5bf",
      "question": "Structure",
      "preferredVariantId": "v-92e120646a",
      "variants": [
        {
          "id": "v-92e120646a",
          "answer": "Visceral peritoneum forms the serosal covering of the stomach.",
