    {
      "id": "f-f055f18aea",
      "question": "Layers",
      "preferredVariantId": "v-2bae3b4353",
      "variants": [
        {
          "id": "v-2bae3b4353",
          "answer": "Parietal peritoneum lines the wall; visceral peritoneum covers organs.",
          "sources": [
            {
              "modelId": "female-pelvis-model-mo8",
              "cardId": "female-pelvis-model-mo8-316",
              "sourceLine": 316
            }
          ]
        },
        {
          "id": "v-79ddf806a3",
          "answer": "Parietal peritoneum lines the body wall; visceral peritoneum covers organs.",
          "sources": [
            {
              "modelId": "female-reproductive-system-model-ms1",
              "cardId": "female-reproductive-system-model-ms1-192",
              "sourceLine": 192
            },
            {
              "modelId": "male-reproductive-system-model-ms2",
