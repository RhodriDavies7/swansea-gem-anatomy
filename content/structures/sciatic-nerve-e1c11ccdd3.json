    },
    {
      "id": "f-d82b56cad9",
      "question": "Course",
      "preferredVariantId": "v-e127105467",
      "variants": [
        {
          "id": "v-70ede2ce8c",
          "answer": "Leaves pelvis through greater sciatic foramen inferior to piriformis and descends in posterior thigh.",
          "sources": [
            {
              "modelId": "female-pelvis-model-mo8",
              "cardId": "female-pelvis-model-mo8-296",
              "sourceLine": 296
            }
          ]
        },
        {
          "id": "v-e127105467",
          "answer": "Usually leaves greater sciatic foramen below piriformis; passes deep to gluteus maximus between greater trochanter and ischial tuberosity, then down posterior thigh; usually divides near upper popliteal fossa, but division level varies.",
          "sources": [
            {
              "modelId": "lower-limb-model-ns10",
              "cardId": "lower-limb-model-ns10-467",
              "sourceLine": 467
            }
          ]
        }
      ],
      "editorialReview": {
        "date": "2026-09-11",
        "basis": "Reviewed supplied source answers; selected or synthesised concise revision wording."
      }
    },
    {
      "id": "f-c8b6915183",
      "question": "Motor functions",
      "preferredVariantId": "v-51e5221016",
      "variants": [
        {
          "id": "v-09097deac8",
          "answer": "Supplies posterior thigh and, via tibial/common fibular branches, most muscles below the knee.",
          "sources": [
            {
              "modelId": "female-pelvis-model-mo8",
              "cardId": "female-pelvis-model-mo8-297",
              "sourceLine": 297
            }
          ]
        },
        {
          "id": "v-51e5221016",
          "answer": "Hamstrings and hamstring part of adductor magnus; through terminal branches, all leg and foot muscles.",
          "sources": [
            {
              "modelId": "lower-limb-model-ns10",
              "cardId": "lower-limb-model-ns10-468",
              "sourceLine": 468
            }
          ]
        }
      ],
      "editorialReview": {
        "date": "2026-09-11",
        "basis": "Reviewed supplied source answers; selected or synthesised concise revision wording."
      }
    },
    {
      "id": "f-a453254382",
      "question": "Sensory functions",
      "preferredVariantId": "v-313ebe4671",
      "variants": [
        {
          "id": "v-fa93dc191e",
          "answer": "Indirectly supplies most of leg and foot through terminal branches.",
          "sources": [
            {
              "modelId": "female-pelvis-model-mo8",
              "cardId": "female-pelvis-model-mo8-298",
              "sourceLine": 298
            }
          ]
        },
        {
          "id": "v-313ebe4671",
          "answer": "No direct cutaneous branches in thigh; terminal branches supply most leg and foot except saphenous territory.",
          "sources": [
            {
              "modelId": "lower-limb-model-ns10",
              "cardId": "lower-limb-model-ns10-469",
              "sourceLine": 469
            }
          ]
        }
      ],
      "editorialReview": {
        "date": "2026-09-11",
        "basis": "Reviewed supplied source answers; selected or synthesised concise revision wording."
      }
    },
    {
      "id": "f-bc53d10c57",
      "question": "Lesion",
      "preferredVariantId": "v-3210974d70",
      "variants": [
        {
          "id": "v-bbd2605be5",
          "answer": "Proximal injury can cause weakness of knee flexion and severe weakness or paralysis of movements below the knee, with sensory loss over much of the leg and foot; the exact pattern depends on the level and which tibial/common fibular fibres are affected.",
          "sources": [
            {
              "modelId": "female-pelvis-model-mo8",
              "cardId": "female-pelvis-model-mo8-299",
              "sourceLine": 299
            }
          ]
        },
        {
          "id": "v-3210974d70",
          "answer": "High lesion weakens knee flexion and severely impairs ankle/toe movement, often causing foot drop; sensory loss affects much of leg/foot while medial leg is spared. Posterior thigh skin is mainly supplied by a separate nerve.",
          "sources": [
            {
              "modelId": "lower-limb-model-ns10",
              "cardId": "lower-limb-model-ns10-470",
              "sourceLine": 470
            }
          ]
        }
      ],
      "editorialReview": {
        "date": "2026-09-11",
        "basis": "Reviewed supplied source answers; selected or synthesised concise revision wording."
      }
    }
