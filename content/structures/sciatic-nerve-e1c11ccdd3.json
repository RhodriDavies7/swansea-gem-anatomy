    {
      "id": "f-4d78ec7d11",
      "question": "Roots",
      "preferredVariantId": "v-e86a293bc5",
      "variants": [
        {
          "id": "v-fab08e9084",
          "answer": "L4–S3 from the sacral plexus.",
          "sources": [
            {
              "modelId": "female-pelvis-model-mo8",
              "cardId": "female-pelvis-model-mo8-295",
              "sourceLine": 295
            }
          ]
        },
        {
          "id": "v-e86a293bc5",
          "answer": "L4–S3; tibial component from anterior divisions and common fibular component from posterior divisions.",
          "sources": [
            {
              "modelId": "lower-limb-model-ns10",
              "cardId": "lower-limb-model-ns10-466",
              "sourceLine": 466
            }
          ]
        }
      ],
      "editorialReview": {
