      "question": "Structure",
      "preferredVariantId": "v-cea323779c",
      "variants": [
        {
          "id": "v-cea323779c",
          "answer": "Pectoral fascia covers pectoralis major; the retromammary space is a loose connective tissue plane between the breast and the deep fascia.",
          "sources": [
            {
              "modelId": "breast-model-ms7",
              "cardId": "breast-model-ms7-52",
              "sourceLine": 52
            }
          ]
        }
      ]
    },
    {
      "id": "f-f1e410ad14",
      "question": "Function",
      "preferredVariantId": "v-3b479bfff8",
      "variants": [
        {
          "id": "v-3b479bfff8",
          "answer": "The retromammary space allows the breast to move relatively freely over the pectoral fascia.",
          "sources": [
            {
              "modelId": "breast-model-ms7",
              "cardId": "breast-model-ms7-53",
              "sourceLine": 53
            }
          ]
        }
      ]
    },
    {
      "id": "f-6519fe11ef",
      "question": "Relations",
      "preferredVariantId": "v-fd2ba5cfd6",
      "variants": [
        {
          "id": "v-fd2ba5cfd6",
          "answer": "Lies deep to the breast and superficial to pectoralis major.",
          "sources": [
            {
              "modelId": "breast-model-ms7",
              "cardId": "breast-model-ms7-54",
              "sourceLine": 54
            }
          ]
        }
      ]
    },
    {
      "id": "f-b03737e3cd",
      "question": "Clinical relevance",
      "preferredVariantId": "v-fc32186c5f",
      "variants": [
        {
          "id": "v-fc32186c5f",
          "answer": "Loss of mobility over the chest wall can occur when malignancy invades the deep fascia or pectoral structures.",
