    },
    {
      "id": "f-2389607e0b",
      "question": "Muscle attachments",
      "preferredVariantId": "v-ede7d72df5",
      "variants": [
        {
          "id": "v-ede7d72df5",
          "answer": "Psoas major attaches to body/transverse process; multifidus to spinous process and mammillary region; intertransversarii and other deep back muscles attach to posterior elements.",
          "sources": [
            {
              "modelId": "lower-limb-model-ns10",
              "cardId": "lower-limb-model-ns10-505",
              "sourceLine": 505
            }
          ]
        }
      ]
    },
    {
      "id": "f-86e4e38754",
      "question": "Orientation",
      "preferredVariantId": "v-c13dc16161",
      "variants": [
        {
          "id": "v-c13dc16161",
          "answer": "Body faces anteriorly; spinous process posteriorly; superior facets face mainly medially. L5 has a large body adapted to the lumbosacral junction; it is a midline bone.",
          "sources": [
            {
              "modelId": "lower-limb-model-ns10",
              "cardId": "lower-limb-model-ns10-506",
              "sourceLine": 506
            }
          ]
        }
      ]
    },
