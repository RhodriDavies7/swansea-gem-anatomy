      "question": "Landmarks",
      "preferredVariantId": "v-a8120a0451",
      "variants": [
        {
          "id": "v-a8120a0451",
          "answer": "Large body, pedicles, laminae, short broad spinous process, transverse processes and superior/inferior articular processes.",
