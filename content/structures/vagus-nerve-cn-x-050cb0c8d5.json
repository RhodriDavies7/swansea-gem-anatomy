    {
      "id": "f-d82b56cad9",
      "question": "Course",
      "preferredVariantId": "v-1d2963d12f",
      "variants": [
        {
          "id": "v-1d2963d12f",
          "answer": "Emerges from postolivary sulcus, exits through jugular foramen and descends in carotid sheath into thorax and abdomen.",
          "sources": [
            {
              "modelId": "cranial-floor-model-bs1",
              "cardId": "cranial-floor-model-bs1-248",
              "sourceLine": 248
            }
          ]
        },
        {
          "id": "v-e9aa615d17",
          "answer": "Exits jugular foramen and descends within carotid sheath into thorax.",
          "sources": [
            {
              "modelId": "head-and-neck-model-cs17-2",
              "cardId": "head-and-neck-model-cs17-2-815",
              "sourceLine": 815
            }
          ]
        },
        {
          "id": "v-e101f16776",
          "answer": "Emerges from postolivary sulcus, exits through jugular foramen and descends in the carotid sheath.",
          "sources": [
            {
              "modelId": "deep-face-model-bs8-1",
              "cardId": "deep-face-model-bs8-1-234",
              "sourceLine": 234
            }
          ]
        },
        {
          "id": "v-b5753a7521",
          "answer": "Descends through the neck and thorax, contributing to cardiac, pulmonary and oesophageal plexuses.",
          "sources": [
            {
              "modelId": "thorax-model-hs21",
              "cardId": "thorax-model-hs21-624"
            }
          ]
        }
      ],
      "editorialReview": {
        "date": "2026-09-11",
        "basis": "Compared source answers; retained concise core facts, functional detail and relevant clinical distinctions."
      }
    },
    {
      "id": "f-c8b6915183",
      "question": "Motor functions",
      "preferredVariantId": "curated-4a3e797c1a",
      "variants": [
        {
          "id": "v-b652dabd18",
          "answer": "Supplies most muscles of palate, pharynx and larynx.",
          "sources": [
            {
              "modelId": "cranial-floor-model-bs1",
              "cardId": "cranial-floor-model-bs1-249",
              "sourceLine": 249
            }
          ]
        },
        {
          "id": "v-8f35973812",
          "answer": "Supplies palate, pharynx and larynx and carries parasympathetic fibres to thoracoabdominal viscera.",
          "sources": [
            {
              "modelId": "head-and-neck-model-cs17-2",
              "cardId": "head-and-neck-model-cs17-2-816",
              "sourceLine": 816
            }
          ]
        },
        {
          "id": "curated-4a3e797c1a",
          "answer": "Supplies most palate, pharynx and larynx muscles; carries parasympathetic fibres to thoracoabdominal viscera.",
          "sources": [
            {
              "modelId": "cranial-floor-model-bs1",
              "cardId": "cranial-floor-model-bs1-249",
              "sourceLine": 249
            },
            {
              "modelId": "head-and-neck-model-cs17-2",
              "cardId": "head-and-neck-model-cs17-2-816",
              "sourceLine": 816
            }
          ],
          "editorial": true
        },
        {
          "id": "v-dfb2133804",
          "answer": "Supplies most muscles of the palate, pharynx and larynx.",
