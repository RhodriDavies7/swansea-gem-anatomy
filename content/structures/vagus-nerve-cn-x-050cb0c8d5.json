    {
      "id": "f-bc53d10c57",
      "question": "Lesion",
      "preferredVariantId": "v-d9495a4840",
      "variants": [
        {
          "id": "v-d9495a4840",
          "answer": "May cause dysphagia and hoarseness, ipsilateral palatal weakness with the uvula deviating away from the lesion, and loss of the efferent limb of the gag reflex.",
          "sources": [
            {
              "modelId": "cranial-floor-model-bs1",
              "cardId": "cranial-floor-model-bs1-252",
              "sourceLine": 252
            },
            {
              "modelId": "deep-face-model-bs8-1",
              "cardId": "deep-face-model-bs8-1-239",
              "sourceLine": 239
            }
          ]
        },
        {
          "id": "v-680968f4f8",
          "answer": "May cause dysphagia and hoarseness, ipsilateral palatal weakness with uvula deviating away from the lesion, and loss of the efferent gag reflex.",
          "sources": [
            {
              "modelId": "head-and-neck-model-cs17-2",
              "cardId": "head-and-neck-model-cs17-2-818",
              "sourceLine": 818
            }
          ]
        },
        {
          "id": "v-68d74af138",
          "answer": "May cause dysphagia, hoarseness, palatal weakness and autonomic dysfunction depending on lesion level.",
          "sources": [
            {
              "modelId": "thorax-model-hs21",
              "cardId": "thorax-model-hs21-627"
            }
          ]
        },
        {
          "id": "v-da32a36c4a",
          "answer": "Dysphagia, hoarseness and ipsilateral palatal weakness; uvula deviates away from a unilateral lesion.",
          "sources": [
            {
              "modelId": "male-torso-with-head-model-as23-1",
              "cardId": "male-torso-with-head-model-as23-1-268"
            }
          ]
        }
      ],
