    {
      "id": "f-a453254382",
      "question": "Sensory functions",
      "preferredVariantId": "v-c3170e2d21",
      "variants": [
        {
          "id": "v-c3170e2d21",
          "answer": "Visceral sensation from thoracoabdominal organs and sensation from larynx/pharynx; taste from epiglottic region.",
          "sources": [
            {
              "modelId": "cranial-floor-model-bs1",
              "cardId": "cranial-floor-model-bs1-250",
              "sourceLine": 250
            },
            {
              "modelId": "deep-face-model-bs8-1",
              "cardId": "deep-face-model-bs8-1-236",
              "sourceLine": 236
            }
          ]
        },
        {
          "id": "v-9940f3aab2",
          "answer": "Visceral sensation, laryngeal/pharyngeal sensation and taste from epiglottic region.",
          "sources": [
            {
              "modelId": "head-and-neck-model-cs17-2",
              "cardId": "head-and-neck-model-cs17-2-817",
              "sourceLine": 817
            }
          ]
        },
        {
          "id": "v-871c2e4d2a",
          "answer": "Visceral afferent supply from thoracic and abdominal viscera.",
          "sources": [
            {
              "modelId": "thorax-model-hs21",
              "cardId": "thorax-model-hs21-626"
            }
          ]
        }
      ],
      "editorialReview": {
