      "preferredVariantId": "v-a3d0efa534",
      "variants": [
        {
          "id": "v-e4a567b79f",
          "answer": "Articulates with the scapula proximally and with the radius and ulna distally.",
          "sources": [
            {
              "modelId": "deep-shoulder-model-ns17",
              "cardId": "deep-shoulder-model-ns17-38",
              "sourceLine": 38
            }
          ]
        },
        {
          "id": "v-4bc1c32541",
          "answer": "Articulates distally with the ulna at the trochlea and with the radius at the capitulum.",
          "sources": [
            {
              "modelId": "elbow-joint-model-ns18",
              "cardId": "elbow-joint-model-ns18-3",
              "sourceLine": 3
            }
          ]
        },
        {
          "id": "v-a3d0efa534",
          "answer": "Scapula proximally at glenohumeral joint; radius and ulna distally at elbow.",
          "sources": [
            {
              "modelId": "upper-limb-model-ns15",
              "cardId": "upper-limb-model-ns15-553",
              "sourceLine": 553
            }
          ]
        }
