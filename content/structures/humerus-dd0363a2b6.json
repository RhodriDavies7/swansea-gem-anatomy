    {
      "id": "f-2389607e0b",
      "question": "Muscle attachments",
      "preferredVariantId": "v-9c95b9e4f6",
      "variants": [
        {
          "id": "v-f1ef17f538",
          "answer": "Rotator cuff inserts around the tubercles; pectoralis major, latissimus dorsi and teres major attach around the intertubercular sulcus.",
          "sources": [
            {
              "modelId": "deep-shoulder-model-ns17",
              "cardId": "deep-shoulder-model-ns17-40",
              "sourceLine": 40
            }
          ]
        },
        {
          "id": "v-1e91ac20f4",
          "answer": "Common flexor origin attaches to the medial epicondyle; common extensor origin attaches to the lateral epicondyle; brachialis and triceps attach proximally/distally around the humerus.",
          "sources": [
            {
              "modelId": "elbow-joint-model-ns18",
              "cardId": "elbow-joint-model-ns18-5",
              "sourceLine": 5
            }
          ]
        },
        {
          "id": "v-9c95b9e4f6",
          "answer": "Rotator cuff on tubercles; pectoralis major, latissimus dorsi and teres major around intertubercular sulcus; deltoid on tuberosity; forearm flexor/extensor groups arise from epicondyles.",
          "sources": [
            {
              "modelId": "upper-limb-model-ns15",
              "cardId": "upper-limb-model-ns15-555",
              "sourceLine": 555
            }
          ]
        }
      ],
      "editorialReview": {
        "date": "2026-09-11",
        "basis": "Reviewed supplied source answers; selected or synthesised concise revision wording."
      }
    },
    {
