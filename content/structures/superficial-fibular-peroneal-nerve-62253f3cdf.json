      "question": "Motor functions",
      "preferredVariantId": "v-1fd4760874",
      "variants": [
        {
          "id": "v-1fd4760874",
          "answer": "Foot eversion through fibularis longus and brevis; assists weak plantarflexion.",
          "sources": [
            {
              "modelId": "lower-limb-model-ns10",
              "cardId": "lower-limb-model-ns10-496",
              "sourceLine": 496
            }
          ]
