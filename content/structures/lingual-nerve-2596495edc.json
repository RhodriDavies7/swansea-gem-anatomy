      "id": "f-d82b56cad9",
      "question": "Course",
      "preferredVariantId": "curated-972cfcc131",
      "variants": [
        {
          "id": "v-268506da1c",
          "answer": "Descends in infratemporal fossa, passes close to mandibular third molar, then runs in floor of mouth around the submandibular duct.",
          "sources": [
            {
              "modelId": "deep-face-model-bs8-1",
              "cardId": "deep-face-model-bs8-1-219",
              "sourceLine": 219
            }
          ]
        },
        {
          "id": "v-8e6eecb7c7",
          "answer": "Passes through infratemporal fossa, receives chorda tympani, then runs in floor of mouth close to submandibular duct.",
          "sources": [
            {
              "modelId": "larynx-and-tongue-model-gs4",
              "cardId": "larynx-and-tongue-model-gs4-280",
              "sourceLine": 280
            }
          ]
        },
        {
          "id": "curated-972cfcc131",
          "answer": "Descends in the infratemporal fossa, receives chorda tympani and passes close to the mandibular third molar; loops beneath the submandibular duct in the floor of the mouth.",
          "sources": [
            {
              "modelId": "deep-face-model-bs8-1",
              "cardId": "deep-face-model-bs8-1-219",
              "sourceLine": 219
            },
