    {
      "id": "f-a453254382",
      "question": "Sensory functions",
      "preferredVariantId": "v-c1fd77a90a",
      "variants": [
        {
          "id": "v-1a13e5c9a0",
          "answer": "General sensation from anterior two-thirds of tongue, floor of mouth and lingual gingiva.",
          "sources": [
            {
              "modelId": "deep-face-model-bs8-1",
              "cardId": "deep-face-model-bs8-1-220",
              "sourceLine": 220
            }
          ]
        },
        {
          "id": "v-c1fd77a90a",
          "answer": "General sensation from anterior two-thirds of tongue, floor of mouth and lingual gingiva; carries chorda tympani taste/parasympathetic fibres after they join it.",
          "sources": [
            {
              "modelId": "larynx-and-tongue-model-gs4",
              "cardId": "larynx-and-tongue-model-gs4-282",
              "sourceLine": 282
            }
          ]
        }
      ],
      "editorialReview": {
        "date": "2026-09-11",
        "basis": "Reviewed supplied source answers; selected or synthesised concise revision wording."
      }
    },
    {
      "id": "f-9f76a2a9d2",
      "question": "Parasympathetic functions",
      "preferredVariantId": "v-091e7a6649",
      "variants": [
        {
          "id": "v-091e7a6649",
          "answer": "Carries chorda tympani taste fibres and preganglionic parasympathetic fibres to the submandibular ganglion.",
          "sources": [
            {
              "modelId": "deep-face-model-bs8-1",
              "cardId": "deep-face-model-bs8-1-221",
              "sourceLine": 221
            }
          ]
        }
      ]
    },
    {
      "id": "f-bc53d10c57",
      "question": "Lesion",
      "preferredVariantId": "v-ae5a914eb5",
      "variants": [
        {
          "id": "v-e251395f82",
          "answer": "Can cause loss of general sensation and taste from anterior tongue and reduced salivary secretion depending on lesion site.",
          "sources": [
            {
              "modelId": "deep-face-model-bs8-1",
              "cardId": "deep-face-model-bs8-1-222",
              "sourceLine": 222
            }
          ]
        },
        {
          "id": "v-ae5a914eb5",
          "answer": "Causes loss of general sensation from anterior two-thirds of tongue; if injured distal to chorda tympani joining, also causes loss of taste and reduced submandibular/sublingual secretion on that side.",
          "sources": [
            {
              "modelId": "larynx-and-tongue-model-gs4",
              "cardId": "larynx-and-tongue-model-gs4-283",
              "sourceLine": 283
            }
          ]
        }
      ],
      "editorialReview": {
