      "question": "Course",
      "preferredVariantId": "curated-975505934e",
      "variants": [
        {
          "id": "v-456c9cccc8",
          "answer": "Ascends in the hepatoduodenal ligament posterior to the hepatic artery and bile duct.",
          "sources": [
            {
              "modelId": "liver-js5",
              "cardId": "liver-js5-91",
              "sourceLine": 91
            }
          ]
        },
        {
          "id": "v-36be48de8c",
          "answer": "Ascends posterior to the first part of the duodenum and within the hepatoduodenal ligament to the liver.",
          "sources": [
            {
              "modelId": "pancreas-model-js11",
              "cardId": "pancreas-model-js11-55",
              "sourceLine": 55
            }
          ]
        },
        {
          "id": "curated-975505934e",
          "answer": "Passes behind the first part of the duodenum, then ascends in the hepatoduodenal ligament posterior to the hepatic artery and bile duct.",
