      "question": "Muscle attachments",
      "preferredVariantId": "v-a0554afeed",
      "variants": [
        {
          "id": "v-a0554afeed",
          "answer": "Calcaneal tendon posteriorly; plantar intrinsic muscles arise from tuberosity; quadratus plantae from plantar surface; extensor digitorum/hallucis brevis from superolateral surface.",
          "sources": [
            {
              "modelId": "lower-limb-model-ns10",
              "cardId": "lower-limb-model-ns10-627",
              "sourceLine": 627
            }
          ]
        }
      ]
    },
