            {
              "modelId": "lower-limb-model-ns10",
              "cardId": "lower-limb-model-ns10-517",
              "sourceLine": 517
            }
          ]
        },
        {
          "id": "v-e4f942b998",
          "answer": "Coccygeus, levator ani and gluteus maximus attach to the coccyx; the anococcygeal body attaches anteriorly.",
          "sources": [
            {
              "modelId": "male-reproductive-system-model-ms2",
