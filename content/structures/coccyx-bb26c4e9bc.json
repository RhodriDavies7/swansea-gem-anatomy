      "question": "Orientation",
      "preferredVariantId": "v-e31d2d964d",
      "variants": [
        {
          "id": "v-f865ab648c",
          "answer": "Curves anteriorly from the sacrum.",
          "sources": [
            {
              "modelId": "female-pelvis-model-mo8",
              "cardId": "female-pelvis-model-mo8-53",
              "sourceLine": 53
            }
          ]
        },
        {
          "id": "v-d8f3871736",
          "answer": "Base superior toward sacrum; tapering apex inferior, usually curving anteriorly; cornua project upward from posterior base.",
          "sources": [
            {
              "modelId": "lower-limb-model-ns10",
              "cardId": "lower-limb-model-ns10-518",
              "sourceLine": 518
            }
          ]
        },
        {
          "id": "v-e31d2d964d",
          "answer": "Base faces superiorly toward the sacrum and the apex points inferiorly, usually curving anteriorly.",
          "sources": [
            {
              "modelId": "male-reproductive-system-model-ms2",
              "cardId": "male-reproductive-system-model-ms2-18",
              "sourceLine": 18
            }
          ]
        }
      ],
