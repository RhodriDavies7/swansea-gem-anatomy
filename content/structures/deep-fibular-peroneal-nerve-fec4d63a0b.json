    {
      "id": "f-d82b56cad9",
      "question": "Course",
      "preferredVariantId": "v-68e796f8c0",
      "variants": [
        {
          "id": "v-68e796f8c0",
          "answer": "Descends in anterior leg with anterior tibial artery and enters dorsum of foot deep to extensor retinacula.",
          "sources": [
            {
              "modelId": "foot-model-ns9",
              "cardId": "foot-model-ns9-289",
              "sourceLine": 289
            }
          ]
        },
        {
          "id": "v-1f5a95e67d",
          "answer": "Enters anterior compartment, accompanies anterior tibial vessels and passes beneath extensor retinacula onto dorsum of foot.",
          "sources": [
            {
              "modelId": "lower-limb-model-ns10",
              "cardId": "lower-limb-model-ns10-488",
              "sourceLine": 488
            }
          ]
        }
      ],
      "editorialReview": {
        "date": "2026-09-11",
        "basis": "Reviewed supplied source answers; selected or synthesised concise revision wording."
      }
    },
    {
      "id": "f-c8b6915183",
      "question": "Motor functions",
      "preferredVariantId": "v-bf36d3ec1d",
      "variants": [
        {
          "id": "v-e5eae4fe2f",
          "answer": "Supplies anterior compartment muscles and extensor digitorum brevis/extensor hallucis brevis.",
          "sources": [
            {
              "modelId": "foot-model-ns9",
              "cardId": "foot-model-ns9-290",
              "sourceLine": 290
            }
          ]
        },
        {
          "id": "v-bf36d3ec1d",
          "answer": "Dorsiflexion and toe extension through anterior leg muscles; supplies extensor digitorum brevis and extensor hallucis brevis.",
          "sources": [
            {
              "modelId": "lower-limb-model-ns10",
              "cardId": "lower-limb-model-ns10-489",
              "sourceLine": 489
            }
          ]
        }
      ],
      "editorialReview": {
        "date": "2026-09-11",
        "basis": "Reviewed supplied source answers; selected or synthesised concise revision wording."
      }
    },
    {
      "id": "f-a453254382",
      "question": "Sensory functions",
      "preferredVariantId": "v-cbd0aa078f",
      "variants": [
        {
          "id": "v-cbd0aa078f",
          "answer": "Sensation to first dorsal web space.",
          "sources": [
            {
              "modelId": "foot-model-ns9",
              "cardId": "foot-model-ns9-291",
              "sourceLine": 291
            }
          ]
        },
        {
          "id": "v-6eb3376921",
          "answer": "First dorsal web space between great and second toes; also joint branches.",
          "sources": [
            {
              "modelId": "lower-limb-model-ns10",
              "cardId": "lower-limb-model-ns10-490",
              "sourceLine": 490
            }
          ]
        }
      ],
      "editorialReview": {
        "date": "2026-09-11",
        "basis": "Reviewed supplied source answers; selected or synthesised concise revision wording."
      }
    },
    {
      "id": "f-bc53d10c57",
      "question": "Lesion",
      "preferredVariantId": "v-df7d8ed662",
      "variants": [
        {
          "id": "v-35488a2c71",
          "answer": "Causes weakness of dorsiflexion and toe extension if injured proximally, with sensory loss in the first dorsal web space.",
          "sources": [
            {
              "modelId": "foot-model-ns9",
              "cardId": "foot-model-ns9-292",
              "sourceLine": 292
            }
          ]
        },
        {
          "id": "v-df7d8ed662",
          "answer": "Proximal lesion causes foot drop and weak toe extension with first web-space sensory loss; distal entrapment at ankle may spare leg muscles.",
          "sources": [
            {
              "modelId": "lower-limb-model-ns10",
              "cardId": "lower-limb-model-ns10-491",
              "sourceLine": 491
            }
          ]
        }
      ],
