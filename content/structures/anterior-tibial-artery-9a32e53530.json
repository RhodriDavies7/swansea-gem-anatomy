      "variants": [
        {
          "id": "v-9f09ce1dc8",
          "answer": "Passes through proximal interosseous membrane into anterior leg and descends with deep fibular nerve.",
          "sources": [
            {
              "modelId": "foot-model-ns9",
              "cardId": "foot-model-ns9-282",
              "sourceLine": 282
            }
          ]
        },
        {
          "id": "v-9a1f10dc05",
          "answer": "Passes through proximal interosseous membrane into anterior compartment; descends on membrane and continues as dorsalis pedis at ankle.",
