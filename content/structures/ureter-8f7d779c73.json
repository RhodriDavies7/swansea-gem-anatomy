    {
      "id": "f-f1e410ad14",
      "question": "Function",
      "preferredVariantId": "v-a992e59182",
      "variants": [
        {
          "id": "v-a992e59182",
          "answer": "Transports urine from renal pelvis to bladder by peristalsis.",
          "sources": [
            {
              "modelId": "female-pelvis-model-mo8",
              "cardId": "female-pelvis-model-mo8-421",
              "sourceLine": 421
            },
            {
              "modelId": "male-torso-with-head-model-as23-1",
              "cardId": "male-torso-with-head-model-as23-1-653"
            }
          ]
        },
        {
          "id": "v-335645f6c7",
          "answer": "Transports urine from the renal pelvis to the urinary bladder by peristalsis.",
          "sources": [
            {
              "modelId": "female-reproductive-system-model-ms1",
              "cardId": "female-reproductive-system-model-ms1-61",
              "sourceLine": 61
            },
            {
              "modelId": "urinary-system-model-ls3-1",
              "cardId": "urinary-system-model-ls3-1-10",
              "sourceLine": 10
            }
          ]
        },
        {
          "id": "v-04a047f236",
          "answer": "Transports urine from renal pelvis to urinary bladder by peristalsis.",
          "sources": [
            {
              "modelId": "kidney-model-ls5",
              "cardId": "kidney-model-ls5-63",
              "sourceLine": 63
            },
            {
              "modelId": "male-reproductive-system-model-ms2",
              "cardId": "male-reproductive-system-model-ms2-97",
              "sourceLine": 97
            }
          ]
        }
      ],
      "editorialReview": {
