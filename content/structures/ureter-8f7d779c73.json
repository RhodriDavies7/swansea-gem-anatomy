      }
    },
    {
      "id": "f-d82b56cad9",
      "question": "Course",
      "preferredVariantId": "v-75f484a4c4",
      "variants": [
        {
          "id": "v-fb8049f405",
          "answer": "Descends retroperitoneally, crosses pelvic brim and runs on lateral pelvic wall before entering bladder.",
          "sources": [
            {
              "modelId": "female-pelvis-model-mo8",
              "cardId": "female-pelvis-model-mo8-422",
              "sourceLine": 422
            }
          ]
        },
        {
          "id": "v-75f484a4c4",
          "answer": "Descends retroperitoneally on psoas, crosses the pelvic brim near the iliac vessels, then runs on the lateral pelvic wall and enters the bladder obliquely.",
          "sources": [
            {
              "modelId": "female-reproductive-system-model-ms1",
              "cardId": "female-reproductive-system-model-ms1-62",
              "sourceLine": 62
            },
            {
              "modelId": "male-reproductive-system-model-ms2",
              "cardId": "male-reproductive-system-model-ms2-98",
              "sourceLine": 98
            }
          ]
        },
        {
          "id": "v-7f3ab1a22a",
          "answer": "Descends retroperitoneally from renal pelvis, crosses pelvic brim and enters bladder obliquely.",
          "sources": [
            {
              "modelId": "kidney-model-ls5",
              "cardId": "kidney-model-ls5-64",
              "sourceLine": 64
            }
          ]
        },
        {
          "id": "v-0e78fd8591",
          "answer": "Descends retroperitoneally from the renal pelvis, crosses the pelvic brim and enters the bladder obliquely.",
          "sources": [
            {
              "modelId": "urinary-system-model-ls3-1",
              "cardId": "urinary-system-model-ls3-1-11",
              "sourceLine": 11
            }
          ]
        }
      ],
      "editorialReview": {
        "date": "2026-09-11",
        "basis": "Reviewed supplied source answers; selected or synthesised concise revision wording."
      }
    },
    {
      "id": "f-6519fe11ef",
      "question": "Relations",
      "preferredVariantId": "curated-0bf117e0d4",
      "variants": [
        {
          "id": "v-f6888837a9",
          "answer": "Passes inferior to uterine artery near cervix — 'water under the bridge'.",
          "sources": [
            {
              "modelId": "female-pelvis-model-mo8",
              "cardId": "female-pelvis-model-mo8-423",
              "sourceLine": 423
            }
          ]
        },
        {
          "id": "v-01ba045f75",
          "answer": "In the female pelvis, passes inferior to the uterine artery near the lateral fornix of the vagina.",
          "sources": [
            {
              "modelId": "female-reproductive-system-model-ms1",
              "cardId": "female-reproductive-system-model-ms1-64",
              "sourceLine": 64
            }
          ]
        },
        {
          "id": "v-7c5bdf8664",
          "answer": "In the male pelvis, passes inferior to the ductus deferens before entering the bladder.",
          "sources": [
            {
              "modelId": "male-reproductive-system-model-ms2",
              "cardId": "male-reproductive-system-model-ms2-100",
              "sourceLine": 100
            }
          ]
        },
        {
          "id": "curated-0bf117e0d4",
          "answer": "Female: passes beneath the uterine artery near the cervix (water under the bridge). Male: passes beneath the ductus deferens before entering the bladder.",
          "sources": [
            {
              "modelId": "female-pelvis-model-mo8",
              "cardId": "female-pelvis-model-mo8-423",
              "sourceLine": 423
            },
            {
              "modelId": "female-reproductive-system-model-ms1",
              "cardId": "female-reproductive-system-model-ms1-64",
              "sourceLine": 64
            },
            {
              "modelId": "male-reproductive-system-model-ms2",
              "cardId": "male-reproductive-system-model-ms2-100",
              "sourceLine": 100
            }
          ],
          "editorial": true
        }
      ],
      "editorialReview": {
        "date": "2026-09-11",
        "basis": "Reviewed supplied source answers; selected or synthesised concise revision wording."
      }
    },
    {
      "id": "f-46ce642ac3",
      "question": "Constrictions",
      "preferredVariantId": "v-37d107d8b6",
      "variants": [
        {
          "id": "v-aae647b560",
          "answer": "Pelviureteric junction, pelvic brim/iliac vessel crossing and vesicoureteric junction.",
          "sources": [
            {
              "modelId": "female-pelvis-model-mo8",
              "cardId": "female-pelvis-model-mo8-424",
              "sourceLine": 424
            }
          ]
        },
        {
          "id": "v-432af105da",
          "answer": "At the pelviureteric junction, where it crosses the iliac vessels/pelvic brim, and at the vesicoureteric junction.",
          "sources": [
            {
              "modelId": "female-reproductive-system-model-ms1",
              "cardId": "female-reproductive-system-model-ms1-63",
              "sourceLine": 63
            }
          ]
        },
        {
          "id": "v-37d107d8b6",
          "answer": "Classically at pelviureteric junction, crossing of iliac vessels/pelvic brim, and vesicoureteric junction.",
          "sources": [
            {
              "modelId": "kidney-model-ls5",
              "cardId": "kidney-model-ls5-65",
              "sourceLine": 65
            }
          ]
        },
        {
          "id": "v-3c12fc8619",
          "answer": "At the pelviureteric junction, crossing of the iliac vessels/pelvic brim, and vesicoureteric junction.",
          "sources": [
            {
              "modelId": "male-reproductive-system-model-ms2",
              "cardId": "male-reproductive-system-model-ms2-99",
              "sourceLine": 99
            }
          ]
        },
        {
          "id": "v-eb1ee0f104",
          "answer": "Common narrowing sites are the pelvi-ureteric junction, crossing of the iliac vessels/pelvic brim, and vesico-ureteric junction.",
          "sources": [
            {
              "modelId": "urinary-system-model-ls3-1",
              "cardId": "urinary-system-model-ls3-1-12",
              "sourceLine": 12
            }
          ]
        }
      ],
      "editorialReview": {
        "date": "2026-09-11",
        "basis": "Reviewed supplied source answers; selected or synthesised concise revision wording."
      }
    },
    {
      "id": "f-b03737e3cd",
      "question": "Clinical relevance",
      "preferredVariantId": "curated-3605690569",
      "variants": [
        {
          "id": "v-47ba0eff7e",
          "answer": "At risk during hysterectomy because of close relation to uterine artery.",
          "sources": [
            {
              "modelId": "female-pelvis-model-mo8",
              "cardId": "female-pelvis-model-mo8-425",
              "sourceLine": 425
            }
          ]
        },
        {
          "id": "v-a459a3ea6d",
          "answer": "Its relationship to the uterine artery is important during hysterectomy because the ureter may be injured.",
          "sources": [
            {
              "modelId": "female-reproductive-system-model-ms1",
              "cardId": "female-reproductive-system-model-ms1-65",
              "sourceLine": 65
            }
          ]
        },
        {
          "id": "v-98e4193e9b",
          "answer": "These constrictions are common sites for ureteric stone impaction.",
          "sources": [
            {
              "modelId": "kidney-model-ls5",
              "cardId": "kidney-model-ls5-66",
              "sourceLine": 66
            }
          ]
        },
        {
          "id": "v-02ef5deae4",
          "answer": "Ureteric calculi commonly lodge at the physiological constrictions.",
          "sources": [
            {
              "modelId": "urinary-system-model-ls3-1",
              "cardId": "urinary-system-model-ls3-1-13",
              "sourceLine": 13
            }
          ]
        },
        {
          "id": "curated-3605690569",
          "answer": "Calculi can lodge at ureteric narrowings. During hysterectomy, the ureter is at risk where it passes beneath the uterine artery.",
          "sources": [
            {
              "modelId": "female-pelvis-model-mo8",
              "cardId": "female-pelvis-model-mo8-425",
              "sourceLine": 425
            },
            {
              "modelId": "female-reproductive-system-model-ms1",
              "cardId": "female-reproductive-system-model-ms1-65",
              "sourceLine": 65
            },
            {
              "modelId": "kidney-model-ls5",
              "cardId": "kidney-model-ls5-66",
              "sourceLine": 66
            },
            {
              "modelId": "urinary-system-model-ls3-1",
              "cardId": "urinary-system-model-ls3-1-13",
              "sourceLine": 13
            }
          ],
          "editorial": true
        }
      ],
      "editorialReview": {
        "date": "2026-09-11",
        "basis": "Reviewed supplied source answers; selected or synthesised concise revision wording."
      }
    },
    {
      "id": "f-65461dd593",
      "question": "Innervation",
      "preferredVariantId": "v-c568acdf15",
      "variants": [
        {
          "id": "v-c568acdf15",
          "answer": "Visceral afferents travel mainly with sympathetic fibres to T11–L2 spinal segments; pain may refer from loin to groin.",
          "sources": [
            {
              "modelId": "male-reproductive-system-model-ms2",
              "cardId": "male-reproductive-system-model-ms2-101",
              "sourceLine": 101
            }
          ]
        }
      ]
    }
