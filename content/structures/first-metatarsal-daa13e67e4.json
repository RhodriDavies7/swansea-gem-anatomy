      "question": "Articulations",
      "preferredVariantId": "v-5ecfb7bdda",
      "variants": [
        {
          "id": "v-5ecfb7bdda",
          "answer": "Medial cuneiform proximally; great-toe proximal phalanx distally; two plantar sesamoids under head. Sometimes articulates with second metatarsal base.",
          "sources": [
            {
              "modelId": "lower-limb-model-ns10",
              "cardId": "lower-limb-model-ns10-637",
              "sourceLine": 637
            }
          ]
        },
        {
          "id": "v-10dfdd2886",
          "answer": "Articulates proximally with medial cuneiform and distally with proximal phalanx of hallux.",
          "sources": [
            {
              "modelId": "foot-model-ns9",
              "cardId": "foot-model-ns9-49",
              "sourceLine": 49
            }
          ]
        }
      ],
      "editorialReview": {
        "date": "2026-09-11",
        "basis": "Compared source answers; retained concise core facts, functional detail and relevant clinical distinctions."
      }
    },
    {
      "id": "f-626b6c1d45",
      "question": "Landmarks",
      "preferredVariantId": "v-e21386964c",
      "variants": [
        {
          "id": "v-e21386964c",
          "answer": "Base, short thick shaft, head and plantar sesamoid grooves.",
          "sources": [
            {
              "modelId": "lower-limb-model-ns10",
              "cardId": "lower-limb-model-ns10-638",
              "sourceLine": 638
            }
          ]
        },
        {
          "id": "v-5cf77aa481",
          "answer": "Base, shaft and head; head has grooves for sesamoid bones.",
          "sources": [
            {
              "modelId": "foot-model-ns9",
              "cardId": "foot-model-ns9-50",
              "sourceLine": 50
            }
          ]
        }
      ],
      "editorialReview": {
        "date": "2026-09-11",
        "basis": "Compared source answers; retained concise core facts, functional detail and relevant clinical distinctions."
      }
    },
    {
      "id": "f-2389607e0b",
      "question": "Muscle attachments",
      "preferredVariantId": "v-3bac365298",
      "variants": [
        {
          "id": "v-3bac365298",
          "answer": "Tibialis anterior attaches medially at base; fibularis longus attaches plantarly at base; first dorsal interosseous arises from lateral side of shaft.",
          "sources": [
            {
              "modelId": "lower-limb-model-ns10",
              "cardId": "lower-limb-model-ns10-639",
              "sourceLine": 639
            }
          ]
        }
      ]
    },
    {
      "id": "f-86e4e38754",
      "question": "Orientation",
      "preferredVariantId": "v-610f2c32ec",
      "variants": [
        {
          "id": "v-610f2c32ec",
          "answer": "Base proximal, rounded head distal; sesamoid grooves plantar; bone lies at medial border of forefoot, with interosseous attachment toward second metatarsal.",
          "sources": [
            {
              "modelId": "lower-limb-model-ns10",
              "cardId": "lower-limb-model-ns10-640",
              "sourceLine": 640
            }
          ]
        }
      ]
    },
