    {
      "id": "f-4d78ec7d11",
      "question": "Roots",
      "preferredVariantId": "v-ced11ab632",
      "variants": [
        {
          "id": "v-c97e13862d",
          "answer": "C6–T1, formed by lateral and medial roots from lateral and medial cords of the brachial plexus.",
          "sources": [
            {
              "modelId": "hand-model-ns13",
              "cardId": "hand-model-ns13-251",
              "sourceLine": 251
            }
          ]
        },
        {
          "id": "v-ced11ab632",
          "answer": "C6–T1, often with C5 contribution; formed by lateral and medial roots from lateral and medial cords.",
          "sources": [
            {
              "modelId": "upper-limb-model-ns15",
              "cardId": "upper-limb-model-ns15-450",
              "sourceLine": 450
            }
          ]
        }
      ],
      "editorialReview": {
