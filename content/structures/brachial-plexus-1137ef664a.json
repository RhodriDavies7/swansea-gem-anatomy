      "question": "Course",
      "preferredVariantId": "v-84d86be41b",
      "variants": [
        {
          "id": "v-84d86be41b",
          "answer": "Roots pass between anterior and middle scalene muscles; trunks cross posterior triangle; divisions form behind clavicle; cords surround axillary artery in axilla.",
          "sources": [
            {
              "modelId": "upper-limb-model-ns15",
              "cardId": "upper-limb-model-ns15-423",
              "sourceLine": 423
            }
          ]
        }
      ]
    },
    {
      "id": "f-c8b6915183",
      "question": "Motor functions",
      "preferredVariantId": "v-fe166ba2ea",
      "variants": [
        {
          "id": "v-fe166ba2ea",
          "answer": "Provides motor innervation to almost all muscles of te upper limb through its terminal and collateral branches.",
          "sources": [
            {
              "modelId": "upper-limb-model-ns15",
              "cardId": "upper-limb-model-ns15-424",
              "sourceLine": 424
            }
          ]
        }
      ]
    },
    {
      "id": "f-a453254382",
      "question": "Sensory functions",
      "preferredVariantId": "v-8de3338224",
      "variants": [
        {
          "id": "v-8de3338224",
          "answer": "Provides most cutaneous and joint sensation of the upper limb through its terminal branches.",
          "sources": [
            {
              "modelId": "upper-limb-model-ns15",
              "cardId": "upper-limb-model-ns15-425",
              "sourceLine": 425
            }
          ]
        }
      ]
    },
