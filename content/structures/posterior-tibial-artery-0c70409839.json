      "question": "Course",
      "preferredVariantId": "v-647ae123d3",
      "variants": [
        {
          "id": "v-7a87ded8ed",
          "answer": "Descends in deep posterior leg and passes behind medial malleolus beneath flexor retinaculum.",
          "sources": [
            {
              "modelId": "foot-model-ns9",
              "cardId": "foot-model-ns9-355",
              "sourceLine": 355
            }
          ]
        },
        {
          "id": "v-647ae123d3",
          "answer": "Descends in deep posterior leg; passes behind medial malleolus beneath flexor retinaculum; divides into medial and lateral plantar arteries.",
          "sources": [
            {
              "modelId": "lower-limb-model-ns10",
              "cardId": "lower-limb-model-ns10-416",
              "sourceLine": 416
            }
          ]
        }
      ],
      "editorialReview": {
        "date": "2026-09-11",
        "basis": "Reviewed supplied source answers; selected or synthesised concise revision wording."
      }
    },
    {
      "id": "f-f578227926",
      "question": "Branches",
      "preferredVariantId": "v-b54280eb1e",
      "variants": [
        {
          "id": "v-c7fcdcb1fd",
          "answer": "Gives fibular artery, calcaneal branches and terminates as medial and lateral plantar arteries.",
          "sources": [
            {
              "modelId": "foot-model-ns9",
              "cardId": "foot-model-ns9-356",
              "sourceLine": 356
            }
          ]
        },
        {
          "id": "v-b54280eb1e",
          "answer": "Muscular, nutrient tibial, medial malleolar and calcaneal branches; medial and lateral plantar terminal branches. Fibular artery is often described as its proximal branch.",
          "sources": [
            {
              "modelId": "lower-limb-model-ns10",
              "cardId": "lower-limb-model-ns10-417",
              "sourceLine": 417
            }
          ]
        }
      ],
