              "modelId": "female-pelvis-model-mo8",
              "cardId": "female-pelvis-model-mo8-323",
              "sourceLine": 323
            }
          ]
        },
        {
          "id": "v-f6656cfc0c",
          "answer": "Lies posterior to the uterus and vagina; the rectouterine pouch lies between rectum and uterus.",
