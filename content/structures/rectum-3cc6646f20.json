      "question": "Relations",
      "preferredVariantId": "curated-bd70bc83d9",
      "variants": [
        {
          "id": "v-02d5d25475",
          "answer": "Posterior to uterus and vagina; rectouterine pouch lies anteriorly in its upper part.",
