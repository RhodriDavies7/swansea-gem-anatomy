      "variants": [
        {
          "id": "v-dae9c034a2",
          "answer": "Articulates with the humeral trochlea at the trochlear notch and with the radius at the proximal and distal radioulnar joints.",
          "sources": [
            {
              "modelId": "elbow-joint-model-ns18",
              "cardId": "elbow-joint-model-ns18-10",
              "sourceLine": 10
            }
          ]
        },
        {
          "id": "v-08d8c4c5ca",
          "answer": "Trochlea of humerus, radial head proximally, radius distally; does not directly articulate with carpal bones.",
          "sources": [
            {
              "modelId": "upper-limb-model-ns15",
              "cardId": "upper-limb-model-ns15-577",
              "sourceLine": 577
            }
          ]
        }
