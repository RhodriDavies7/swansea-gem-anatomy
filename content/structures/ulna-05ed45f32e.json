    {
      "id": "f-2389607e0b",
      "question": "Muscle attachments",
      "preferredVariantId": "v-13a9db2400",
      "variants": [
        {
          "id": "v-13a9db2400",
          "answer": "Triceps inserts on olecranon; brachialis inserts on coronoid process/ulnar tuberosity; pronator teres and flexor muscles attach in the proximal forearm region.",
          "sources": [
            {
              "modelId": "elbow-joint-model-ns18",
              "cardId": "elbow-joint-model-ns18-12",
              "sourceLine": 12
            }
          ]
        },
        {
          "id": "v-b37efa8e33",
          "answer": "Triceps, brachialis, FCU, FDP, pronator quadratus, supinator and multiple deep forearm muscles.",
          "sources": [
            {
              "modelId": "upper-limb-model-ns15",
              "cardId": "upper-limb-model-ns15-579",
              "sourceLine": 579
            }
          ]
        }
      ],
      "editorialReview": {
        "date": "2026-09-11",
        "basis": "Reviewed supplied source answers; selected or synthesised concise revision wording."
      }
    },
    {
