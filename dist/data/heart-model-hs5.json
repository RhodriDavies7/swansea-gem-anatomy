        "Connections",
        "HeartChamber",
        "Chambers",
        "HS5"
      ],
      "sourceLine": 27,
      "section": "Chambers",
      "label": "II"
    },
    {
      "id": "heart-model-hs5-28",
      "path": [
        "II"
      ],
