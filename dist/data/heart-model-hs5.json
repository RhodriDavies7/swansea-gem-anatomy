      "section": "Major landmarks",
      "label": "A"
    },
    {
      "id": "heart-model-hs5-6",
      "path": [
        "A"
      ],
      "question": "Clinical relevance",
      "answer": "The apex beat is normally palpable in the left 5th intercostal space near the midclavicular line.",
