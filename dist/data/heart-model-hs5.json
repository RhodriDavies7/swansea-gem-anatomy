        "MajorLandmarks",
        "HS5"
      ],
      "sourceLine": 9,
      "section": "Major landmarks",
      "label": "B"
    },
    {
      "id": "heart-model-hs5-10",
      "path": [
        "B"
      ],
      "question": "Function",
      "answer": "Separates the right and left ventricles and allows the two circulations to operate at different pressures.",
