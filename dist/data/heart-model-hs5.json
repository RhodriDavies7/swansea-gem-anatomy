        "AuriclesVesselsValves",
        "HS5"
      ],
      "sourceLine": 105,
      "section": "Auricles, great vessels and valves",
      "label": "k"
    },
    {
      "id": "heart-model-hs5-106",
      "path": [
        "k"
      ],
