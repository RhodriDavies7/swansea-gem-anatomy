        "Function",
        "CardiacStructure",
        "MajorLandmarks",
        "HS5"
      ],
      "sourceLine": 10,
      "section": "Major landmarks",
      "label": "B"
    },
    {
      "id": "heart-model-hs5-11",
      "path": [
        "B"
      ],
      "question": "Parts",
      "answer": "Has a large muscular part and a small membranous part.",
      "tags": [
        "Parts",
        "CardiacStructure",
        "MajorLandmarks",
        "HS5"
      ],
      "sourceLine": 11,
      "section": "Major landmarks",
      "label": "B"
    },
    {
      "id": "heart-model-hs5-12",
      "path": [
        "B"
      ],
      "question": "Relations",
      "answer": "Traversed by components of the cardiac conduction system, including the atrioventricular bundle and bundle branches.",
      "tags": [
        "Relations",
        "CardiacStructure",
        "MajorLandmarks",
        "HS5"
      ],
      "sourceLine": 12,
      "section": "Major landmarks",
      "label": "B"
    },
    {
      "id": "heart-model-hs5-13",
      "path": [
        "B"
      ],
      "question": "Clinical relevance",
      "answer": "Ventricular septal defects most commonly involve the membranous region.",
      "tags": [
        "Clinical",
        "CardiacStructure",
        "MajorLandmarks",
        "HS5"
      ],
      "sourceLine": 13,
      "section": "Major landmarks",
