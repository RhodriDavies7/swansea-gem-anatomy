{
  "id": "knee-joint-model-ns19",
  "name": "Knee Joint (Model NS19)",
  "cards": [
    {
      "id": "knee-joint-model-ns19-3",
      "path": [
        "1"
      ],
      "question": "Identification",
      "answer": "Femur",
      "tags": [
        "Identification",
        "Bone",
        "Bones",
        "NS19"
      ],
      "sourceLine": 3,
      "section": "Bones",
      "label": "1"
    },
    {
      "id": "knee-joint-model-ns19-4",
      "path": [
        "1"
      ],
      "question": "Articulations",
      "answer": "Distally articulates with tibia and patella at the knee joint.",
      "tags": [
        "Articulations",
        "Bone",
        "Bones",
        "NS19"
      ],
      "sourceLine": 4,
      "section": "Bones",
      "label": "1"
    },
    {
      "id": "knee-joint-model-ns19-5",
      "path": [
        "1"
      ],
      "question": "Landmarks",
      "answer": "Medial and lateral condyles, medial and lateral epicondyles, intercondylar fossa and patellar surface.",
      "tags": [
        "Landmarks",
        "Bone",
        "Bones",
        "NS19"
      ],
      "sourceLine": 5,
      "section": "Bones",
      "label": "1"
    },
    {
      "id": "knee-joint-model-ns19-6",
      "path": [
        "1"
      ],
      "question": "Function",
      "answer": "Transmits body weight from hip to knee and provides attachment for major knee ligaments and muscles.",
      "tags": [
        "Function",
        "Bone",
        "Bones",
        "NS19"
      ],
      "sourceLine": 6,
      "section": "Bones",
      "label": "1"
    },
    {
      "id": "knee-joint-model-ns19-9",
      "path": [
        "2"
      ],
      "question": "Identification",
      "answer": "Patella",
      "tags": [
        "Identification",
        "Bone",
        "Bones",
        "NS19"
      ],
      "sourceLine": 9,
      "section": "Bones",
      "label": "2"
    },
    {
      "id": "knee-joint-model-ns19-10",
      "path": [
        "2"
      ],
      "question": "Articulations",
      "answer": "Articulates posteriorly with the patellar surface of the femur.",
      "tags": [
        "Articulations",
        "Bone",
        "Bones",
        "NS19"
      ],
      "sourceLine": 10,
      "section": "Bones",
      "label": "2"
    },
    {
      "id": "knee-joint-model-ns19-11",
      "path": [
        "2"
      ],
      "question": "Structure",
      "answer": "Largest sesamoid bone, embedded in the quadriceps tendon.",
      "tags": [
        "Structure",
        "Bone",
        "Bones",
        "NS19"
      ],
      "sourceLine": 11,
      "section": "Bones",
      "label": "2"
    },
    {
      "id": "knee-joint-model-ns19-12",
      "path": [
        "2"
      ],
      "question": "Function",
      "answer": "Increases the moment arm of quadriceps and protects the anterior knee joint.",
      "tags": [
        "Function",
        "Bone",
        "Bones",
        "NS19"
      ],
      "sourceLine": 12,
      "section": "Bones",
      "label": "2"
    },
    {
      "id": "knee-joint-model-ns19-13",
      "path": [
        "2"
      ],
      "question": "Attachments",
      "answer": "Quadriceps tendon attaches superiorly and patellar ligament inferiorly.",
      "tags": [
        "Attachments",
        "Bone",
        "Bones",
        "NS19"
      ],
      "sourceLine": 13,
      "section": "Bones",
      "label": "2"
    },
    {
      "id": "knee-joint-model-ns19-16",
      "path": [
        "3"
      ],
      "question": "Identification",
      "answer": "Tibia",
      "tags": [
        "Identification",
        "Bone",
        "Bones",
        "NS19"
      ],
      "sourceLine": 16,
      "section": "Bones",
      "label": "3"
    },
    {
      "id": "knee-joint-model-ns19-17",
      "path": [
        "3"
      ],
      "question": "Articulations",
      "answer": "Proximally articulates with femoral condyles and fibular head.",
      "tags": [
        "Articulations",
        "Bone",
        "Bones",
        "NS19"
      ],
      "sourceLine": 17,
      "section": "Bones",
      "label": "3"
    },
    {
      "id": "knee-joint-model-ns19-18",
      "path": [
        "3"
      ],
      "question": "Landmarks",
      "answer": "Medial and lateral condyles, intercondylar eminence and tibial tuberosity.",
      "tags": [
        "Landmarks",
        "Bone",
        "Bones",
        "NS19"
      ],
      "sourceLine": 18,
      "section": "Bones",
      "label": "3"
    },
    {
      "id": "knee-joint-model-ns19-19",
      "path": [
        "3"
      ],
      "question": "Function",
      "answer": "Main weight-bearing bone of the leg and distal attachment site for major knee stabilisers.",
      "tags": [
        "Function",
        "Bone",
        "Bones",
        "NS19"
      ],
      "sourceLine": 19,
      "section": "Bones",
      "label": "3"
    },
    {
      "id": "knee-joint-model-ns19-23",
      "path": [
        "4"
      ],
      "question": "Identification",
      "answer": "Patellar ligament (ligamentum patellae / patellar tendon)",
      "tags": [
        "Identification",
        "Ligament",
        "LigamentsAndMenisci",
        "NS19"
      ],
      "sourceLine": 23,
      "section": "Ligaments and menisci",
      "label": "4"
    },
    {
      "id": "knee-joint-model-ns19-24",
      "path": [
        "4"
      ],
      "question": "Attachments",
      "answer": "From apex and adjacent margins of patella to tibial tuberosity.",
      "tags": [
        "Attachments",
        "Ligament",
        "LigamentsAndMenisci",
        "NS19"
      ],
      "sourceLine": 24,
      "section": "Ligaments and menisci",
      "label": "4"
    },
    {
      "id": "knee-joint-model-ns19-25",
      "path": [
        "4"
      ],
      "question": "Function",
      "answer": "Continuation of quadriceps extensor mechanism, transmitting force to extend the knee.",
      "tags": [
        "Function",
        "Ligament",
        "LigamentsAndMenisci",
        "NS19"
      ],
      "sourceLine": 25,
      "section": "Ligaments and menisci",
      "label": "4"
    },
    {
      "id": "knee-joint-model-ns19-26",
      "path": [
        "4"
      ],
      "question": "Relations",
      "answer": "Lies anterior to the knee joint capsule.",
      "tags": [
        "Relations",
        "Ligament",
        "LigamentsAndMenisci",
        "NS19"
      ],
      "sourceLine": 26,
      "section": "Ligaments and menisci",
      "label": "4"
    },
    {
      "id": "knee-joint-model-ns19-27",
      "path": [
        "4"
      ],
      "question": "Clinical relevance",
      "answer": "Patellar tendon rupture causes loss of active knee extension and a high-riding patella may be seen.",
      "tags": [
        "Clinical",
        "Ligament",
        "LigamentsAndMenisci",
        "NS19"
      ],
      "sourceLine": 27,
      "section": "Ligaments and menisci",
      "label": "4"
    },
    {
      "id": "knee-joint-model-ns19-30",
      "path": [
        "5"
      ],
      "question": "Identification",
      "answer": "Medial meniscus",
      "tags": [
        "Identification",
        "Meniscus",
        "LigamentsAndMenisci",
        "NS19"
      ],
      "sourceLine": 30,
      "section": "Ligaments and menisci",
      "label": "5"
    },
    {
      "id": "knee-joint-model-ns19-31",
      "path": [
        "5"
      ],
      "question": "Structure",
      "answer": "C-shaped fibrocartilage attached to tibial plateau; less mobile than lateral meniscus.",
      "tags": [
        "Structure",
        "Meniscus",
        "LigamentsAndMenisci",
        "NS19"
      ],
      "sourceLine": 31,
      "section": "Ligaments and menisci",
      "label": "5"
    },
    {
      "id": "knee-joint-model-ns19-32",
      "path": [
        "5"
      ],
      "question": "Attachments",
      "answer": "Firmly attached to joint capsule and medial collateral ligament.",
      "tags": [
        "Attachments",
        "Meniscus",
        "LigamentsAndMenisci",
        "NS19"
      ],
      "sourceLine": 32,
      "section": "Ligaments and menisci",
      "label": "5"
    },
    {
      "id": "knee-joint-model-ns19-33",
      "path": [
        "5"
      ],
      "question": "Function",
      "answer": "Improves joint congruence, distributes load and absorbs shock.",
      "tags": [
        "Function",
        "Meniscus",
        "LigamentsAndMenisci",
        "NS19"
      ],
      "sourceLine": 33,
      "section": "Ligaments and menisci",
      "label": "5"
    },
    {
      "id": "knee-joint-model-ns19-34",
      "path": [
        "5"
      ],
      "question": "Clinical relevance",
      "answer": "More commonly injured than lateral meniscus, especially with twisting injuries involving valgus stress.",
      "tags": [
        "Clinical",
        "Meniscus",
        "LigamentsAndMenisci",
        "NS19"
      ],
      "sourceLine": 34,
      "section": "Ligaments and menisci",
      "label": "5"
    },
    {
      "id": "knee-joint-model-ns19-37",
      "path": [
        "6"
      ],
      "question": "Identification",
      "answer": "Medial (tibial) collateral ligament",
      "tags": [
        "Identification",
        "Ligament",
        "LigamentsAndMenisci",
        "NS19"
      ],
      "sourceLine": 37,
      "section": "Ligaments and menisci",
      "label": "6"
    },
    {
      "id": "knee-joint-model-ns19-38",
      "path": [
        "6"
      ],
      "question": "Attachments",
      "answer": "From medial femoral epicondyle to medial tibial condyle and proximal medial tibia.",
      "tags": [
        "Attachments",
        "Ligament",
        "LigamentsAndMenisci",
        "NS19"
      ],
      "sourceLine": 38,
      "section": "Ligaments and menisci",
      "label": "6"
    },
    {
      "id": "knee-joint-model-ns19-39",
      "path": [
        "6"
      ],
      "question": "Function",
      "answer": "Resists valgus stress and contributes to medial knee stability.",
      "tags": [
        "Function",
        "Ligament",
        "LigamentsAndMenisci",
        "NS19"
      ],
      "sourceLine": 39,
      "section": "Ligaments and menisci",
      "label": "6"
    },
    {
      "id": "knee-joint-model-ns19-40",
      "path": [
        "6"
      ],
      "question": "Relations",
      "answer": "Deep fibres blend with joint capsule and medial meniscus.",
      "tags": [
        "Relations",
        "Ligament",
        "LigamentsAndMenisci",
        "NS19"
      ],
      "sourceLine": 40,
      "section": "Ligaments and menisci",
      "label": "6"
    },
    {
      "id": "knee-joint-model-ns19-41",
      "path": [
        "6"
      ],
      "question": "Clinical relevance",
      "answer": "Can be injured with valgus force; associated medial meniscal injury may occur because of their attachment.",
      "tags": [
        "Clinical",
        "Ligament",
        "LigamentsAndMenisci",
        "NS19"
      ],
      "sourceLine": 41,
      "section": "Ligaments and menisci",
      "label": "6"
    },
    {
      "id": "knee-joint-model-ns19-44",
      "path": [
        "7"
      ],
      "question": "Identification",
      "answer": "Lateral (fibular) collateral ligament",
      "tags": [
        "Identification",
        "Ligament",
        "LigamentsAndMenisci",
        "NS19"
      ],
      "sourceLine": 44,
      "section": "Ligaments and menisci",
      "label": "7"
    },
    {
      "id": "knee-joint-model-ns19-45",
      "path": [
        "7"
      ],
      "question": "Attachments",
      "answer": "From lateral femoral epicondyle to head of fibula.",
      "tags": [
        "Attachments",
        "Ligament",
        "LigamentsAndMenisci",
        "NS19"
      ],
      "sourceLine": 45,
      "section": "Ligaments and menisci",
      "label": "7"
    },
    {
      "id": "knee-joint-model-ns19-46",
      "path": [
        "7"
      ],
      "question": "Function",
      "answer": "Resists varus stress and stabilises lateral knee.",
      "tags": [
        "Function",
        "Ligament",
        "LigamentsAndMenisci",
        "NS19"
      ],
      "sourceLine": 46,
      "section": "Ligaments and menisci",
      "label": "7"
    },
    {
      "id": "knee-joint-model-ns19-47",
      "path": [
        "7"
      ],
      "question": "Relations",
      "answer": "Cord-like and extracapsular; does not attach to lateral meniscus.",
      "tags": [
        "Relations",
        "Ligament",
        "LigamentsAndMenisci",
        "NS19"
      ],
      "sourceLine": 47,
      "section": "Ligaments and menisci",
      "label": "7"
    },
    {
      "id": "knee-joint-model-ns19-48",
      "path": [
        "7"
      ],
      "question": "Clinical relevance",
      "answer": "Injury causes lateral instability and may occur with posterolateral corner injuries.",
      "tags": [
        "Clinical",
        "Ligament",
        "LigamentsAndMenisci",
        "NS19"
      ],
      "sourceLine": 48,
      "section": "Ligaments and menisci",
      "label": "7"
    },
    {
      "id": "knee-joint-model-ns19-51",
      "path": [
        "8"
      ],
      "question": "Identification",
      "answer": "Anterior cruciate ligament",
      "tags": [
        "Identification",
        "Ligament",
        "LigamentsAndMenisci",
        "NS19"
      ],
      "sourceLine": 51,
      "section": "Ligaments and menisci",
      "label": "8"
    },
    {
      "id": "knee-joint-model-ns19-52",
      "path": [
        "8"
      ],
      "question": "Attachments",
      "answer": "From anterior intercondylar area of tibia to posteromedial aspect of lateral femoral condyle.",
      "tags": [
        "Attachments",
        "Ligament",
        "LigamentsAndMenisci",
        "NS19"
      ],
      "sourceLine": 52,
      "section": "Ligaments and menisci",
      "label": "8"
    },
    {
      "id": "knee-joint-model-ns19-53",
      "path": [
        "8"
      ],
      "question": "Function",
      "answer": "Prevents anterior translation of tibia relative to femur and limits hyperextension/rotation.",
      "tags": [
        "Function",
        "Ligament",
        "LigamentsAndMenisci",
        "NS19"
      ],
      "sourceLine": 53,
      "section": "Ligaments and menisci",
      "label": "8"
    },
    {
      "id": "knee-joint-model-ns19-54",
      "path": [
        "8"
      ],
      "question": "Relations",
      "answer": "Intracapsular but extrasynovial.",
      "tags": [
        "Relations",
        "Ligament",
        "LigamentsAndMenisci",
        "NS19"
      ],
      "sourceLine": 54,
      "section": "Ligaments and menisci",
      "label": "8"
    },
    {
      "id": "knee-joint-model-ns19-55",
      "path": [
        "8"
      ],
      "question": "Clinical relevance",
      "answer": "Rupture may cause a positive Lachman/anterior drawer test and rotational instability.",
      "tags": [
        "Clinical",
        "Ligament",
        "LigamentsAndMenisci",
        "NS19"
      ],
      "sourceLine": 55,
      "section": "Ligaments and menisci",
      "label": "8"
    },
    {
      "id": "knee-joint-model-ns19-58",
      "path": [
        "9"
      ],
      "question": "Identification",
      "answer": "Posterior cruciate ligament",
      "tags": [
        "Identification",
        "Ligament",
        "LigamentsAndMenisci",
        "NS19"
      ],
      "sourceLine": 58,
      "section": "Ligaments and menisci",
      "label": "9"
    },
    {
      "id": "knee-joint-model-ns19-59",
      "path": [
        "9"
      ],
      "question": "Attachments",
      "answer": "From posterior intercondylar area of tibia to lateral surface of medial femoral condyle.",
      "tags": [
        "Attachments",
        "Ligament",
        "LigamentsAndMenisci",
        "NS19"
      ],
      "sourceLine": 59,
      "section": "Ligaments and menisci",
      "label": "9"
    },
    {
      "id": "knee-joint-model-ns19-60",
      "path": [
        "9"
      ],
      "question": "Function",
      "answer": "Prevents posterior translation of tibia relative to femur and limits hyperflexion.",
      "tags": [
        "Function",
        "Ligament",
        "LigamentsAndMenisci",
        "NS19"
      ],
      "sourceLine": 60,
      "section": "Ligaments and menisci",
      "label": "9"
    },
    {
      "id": "knee-joint-model-ns19-61",
      "path": [
        "9"
      ],
      "question": "Relations",
      "answer": "Intracapsular but extrasynovial and generally stronger than the ACL.",
      "tags": [
        "Relations",
        "Ligament",
        "LigamentsAndMenisci",
        "NS19"
      ],
      "sourceLine": 61,
      "section": "Ligaments and menisci",
      "label": "9"
    },
    {
      "id": "knee-joint-model-ns19-62",
      "path": [
        "9"
      ],
      "question": "Clinical relevance",
      "answer": "Dashboard-type trauma may rupture the PCL; posterior drawer test may be positive.",
      "tags": [
        "Clinical",
        "Ligament",
        "LigamentsAndMenisci",
        "NS19"
      ],
      "sourceLine": 62,
      "section": "Ligaments and menisci",
      "label": "9"
    },
    {
      "id": "knee-joint-model-ns19-65",
      "path": [
        "10"
      ],
      "question": "Identification",
      "answer": "Interosseous membrane",
      "tags": [
        "Identification",
        "Membrane",
        "LigamentsAndMenisci",
        "NS19"
      ],
      "sourceLine": 65,
      "section": "Ligaments and menisci",
      "label": "10"
    },
    {
      "id": "knee-joint-model-ns19-66",
      "path": [
        "10"
      ],
      "question": "Attachments",
      "answer": "Connects interosseous borders of tibia and fibula.",
      "tags": [
        "Attachments",
        "Membrane",
        "LigamentsAndMenisci",
        "NS19"
      ],
      "sourceLine": 66,
      "section": "Ligaments and menisci",
      "label": "10"
    },
    {
      "id": "knee-joint-model-ns19-67",
      "path": [
        "10"
      ],
      "question": "Function",
      "answer": "Stabilises tibiofibular relationship and provides extensive muscle attachment.",
      "tags": [
        "Function",
        "Membrane",
        "LigamentsAndMenisci",
        "NS19"
      ],
      "sourceLine": 67,
      "section": "Ligaments and menisci",
      "label": "10"
    },
    {
      "id": "knee-joint-model-ns19-68",
      "path": [
        "10"
      ],
      "question": "Relations",
      "answer": "Separates anterior and posterior compartments of the leg.",
      "tags": [
        "Relations",
        "Membrane",
        "LigamentsAndMenisci",
        "NS19"
      ],
      "sourceLine": 68,
      "section": "Ligaments and menisci",
      "label": "10"
    },
    {
      "id": "knee-joint-model-ns19-71",
      "path": [
        "11"
      ],
      "question": "Identification",
      "answer": "Anterior ligament of the head of the fibula",
      "tags": [
        "Identification",
        "Ligament",
        "LigamentsAndMenisci",
        "NS19"
      ],
      "sourceLine": 71,
      "section": "Ligaments and menisci",
      "label": "11"
    },
    {
      "id": "knee-joint-model-ns19-72",
      "path": [
        "11"
      ],
      "question": "Attachments",
      "answer": "Connects anterior aspect of fibular head to lateral tibial condyle.",
      "tags": [
        "Attachments",
        "Ligament",
        "LigamentsAndMenisci",
        "NS19"
      ],
      "sourceLine": 72,
      "section": "Ligaments and menisci",
      "label": "11"
    },
    {
      "id": "knee-joint-model-ns19-73",
      "path": [
        "11"
      ],
      "question": "Function",
      "answer": "Reinforces anterior aspect of the proximal tibiofibular joint.",
      "tags": [
        "Function",
        "Ligament",
        "LigamentsAndMenisci",
        "NS19"
      ],
      "sourceLine": 73,
      "section": "Ligaments and menisci",
      "label": "11"
    },
    {
      "id": "knee-joint-model-ns19-74",
      "path": [
        "11"
      ],
      "question": "Relations",
      "answer": "Part of the capsular ligamentous support of the proximal tibiofibular joint.",
      "tags": [
        "Relations",
        "Ligament",
        "LigamentsAndMenisci",
        "NS19"
      ],
      "sourceLine": 74,
      "section": "Ligaments and menisci",
      "label": "11"
    },
    {
      "id": "knee-joint-model-ns19-77",
      "path": [
        "12"
      ],
      "question": "Identification",
      "answer": "Posterior meniscofemoral ligament",
      "tags": [
        "Identification",
        "Ligament",
        "LigamentsAndMenisci",
        "NS19"
      ],
      "sourceLine": 77,
      "section": "Ligaments and menisci",
      "label": "12"
    },
    {
      "id": "knee-joint-model-ns19-78",
      "path": [
        "12"
      ],
      "question": "Also called",
      "answer": "Commonly referred to as the ligament of Wrisberg when passing posterior to the PCL.",
      "tags": [
        "AlsoCalled",
        "Ligament",
        "LigamentsAndMenisci",
        "NS19"
      ],
      "sourceLine": 78,
      "section": "Ligaments and menisci",
      "label": "12"
    },
    {
      "id": "knee-joint-model-ns19-79",
      "path": [
        "12"
      ],
      "question": "Attachments",
      "answer": "Runs from posterior horn of lateral meniscus to medial femoral condyle.",
      "tags": [
        "Attachments",
        "Ligament",
        "LigamentsAndMenisci",
        "NS19"
      ],
      "sourceLine": 79,
      "section": "Ligaments and menisci",
      "label": "12"
    },
    {
      "id": "knee-joint-model-ns19-80",
      "path": [
        "12"
      ],
      "question": "Function",
