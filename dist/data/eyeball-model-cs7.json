      ],
      "question": "Clinical relevance",
      "answer": "The subarachnoid space around the optic nerve is continuous with intracranial CSF, so raised intracranial pressure can produce papilloedema.",
      "tags": [
        "Clinical",
        "Meninges",
        "CS7"
      ],
      "sourceLine": 91,
      "section": "",
      "label": "14"
    },
    {
      "id": "eyeball-model-cs7-94",
      "path": [
        "15"
      ],
      "question": "Identification",
      "answer": "Long and short ciliary nerves and ciliary arteries entering eyeball",
      "tags": [
        "Identification",
        "NeurovascularBundle",
        "CS7"
      ],
      "sourceLine": 94,
      "section": "",
      "label": "15"
    },
    {
      "id": "eyeball-model-cs7-95",
      "path": [
        "15"
      ],
      "question": "Course",
      "answer": "Ciliary nerves and arteries pierce the sclera posteriorly and travel within the wall of the eyeball.",
      "tags": [
        "Course",
        "NeurovascularBundle",
        "CS7"
      ],
      "sourceLine": 95,
      "section": "",
      "label": "15"
    },
    {
      "id": "eyeball-model-cs7-96",
      "path": [
        "15"
      ],
      "question": "Function",
      "answer": "Ciliary nerves carry sensory/autonomic fibres; ciliary arteries supply the choroid, ciliary body and iris.",
      "tags": [
        "Function",
        "NeurovascularBundle",
        "CS7"
      ],
      "sourceLine": 96,
      "section": "",
      "label": "15"
    },
    {
      "id": "eyeball-model-cs7-97",
      "path": [
        "15"
      ],
      "question": "Relations",
      "answer": "Enter the posterior globe around the optic nerve.",
      "tags": [
        "Relations",
        "NeurovascularBundle",
        "CS7"
      ],
      "sourceLine": 97,
      "section": "",
      "label": "15"
    },
    {
      "id": "eyeball-model-cs7-100",
      "path": [
        "16"
      ],
      "question": "Identification",
      "answer": "Optic nerve (CN II) with central retinal artery and vein",
      "tags": [
        "Identification",
        "Nerve",
        "CS7"
      ],
      "sourceLine": 100,
      "section": "",
      "label": "16"
    },
    {
      "id": "eyeball-model-cs7-101",
      "path": [
        "16"
      ],
      "question": "Roots",
      "answer": "Optic nerve is formed by axons of retinal ganglion cells.",
      "tags": [
        "Roots",
        "Nerve",
        "CS7"
      ],
      "sourceLine": 101,
      "section": "",
      "label": "16"
    },
    {
      "id": "eyeball-model-cs7-102",
      "path": [
        "16"
      ],
      "question": "Course",
      "answer": "Leaves the posterior globe, passes through the optic canal and reaches the optic chiasm; central retinal vessels travel within the nerve.",
      "tags": [
        "Course",
        "Nerve",
        "CS7"
      ],
      "sourceLine": 102,
      "section": "",
      "label": "16"
    },
    {
      "id": "eyeball-model-cs7-103",
      "path": [
        "16"
      ],
      "question": "Sensory functions",
      "answer": "Vision and afferent limb of the pupillary light reflex.",
      "tags": [
        "Sensory",
        "Nerve",
        "CS7"
      ],
      "sourceLine": 103,
      "section": "",
      "label": "16"
    },
    {
      "id": "eyeball-model-cs7-104",
      "path": [
        "16"
      ],
      "question": "Contents",
      "answer": "Central retinal artery and vein run within the optic nerve to and from the retina.",
      "tags": [
        "Contents",
        "Nerve",
        "CS7"
      ],
      "sourceLine": 104,
      "section": "",
      "label": "16"
    },
    {
      "id": "eyeball-model-cs7-105",
      "path": [
        "16"
      ],
      "question": "Lesion",
      "answer": "Optic nerve lesion causes ipsilateral monocular visual loss and an afferent pupillary defect.",
      "tags": [
        "Lesion",
        "Nerve",
        "CS7"
      ],
      "sourceLine": 105,
      "section": "",
      "label": "16"
    },
    {
      "id": "eyeball-model-cs7-108",
      "path": [
        "17"
      ],
      "question": "Identification",
      "answer": "Ciliary muscle",
      "tags": [
        "Identification",
        "Muscle",
        "CS7"
      ],
      "sourceLine": 108,
      "section": "",
      "label": "17"
    },
    {
      "id": "eyeball-model-cs7-109",
      "path": [
        "17"
      ],
      "question": "Actions",
      "answer": "Contracts during accommodation, reducing tension on zonular fibres so the lens becomes more convex for near vision.",
      "tags": [
        "Action",
        "Muscle",
        "CS7"
      ],
      "sourceLine": 109,
      "section": "",
      "label": "17"
    },
    {
      "id": "eyeball-model-cs7-110",
      "path": [
        "17"
      ],
      "question": "Innervation",
      "answer": "Parasympathetic fibres from oculomotor nerve via ciliary ganglion and short ciliary nerves.",
      "tags": [
        "Innervation",
        "Muscle",
        "CS7"
      ],
      "sourceLine": 110,
      "section": "",
      "label": "17"
    },
    {
      "id": "eyeball-model-cs7-111",
      "path": [
        "17"
      ],
      "question": "Location",
      "answer": "Smooth muscle within the ciliary body.",
      "tags": [
        "Location",
        "Muscle",
        "CS7"
      ],
      "sourceLine": 111,
      "section": "",
      "label": "17"
    },
    {
      "id": "eyeball-model-cs7-114",
      "path": [
        "18"
      ],
      "question": "Identification",
      "answer": "Corona ciliaris",
      "tags": [
        "Identification",
        "EyeStructure",
        "CS7"
      ],
      "sourceLine": 114,
      "section": "",
      "label": "18"
    },
    {
      "id": "eyeball-model-cs7-115",
      "path": [
        "18"
      ],
      "question": "Structure",
      "answer": "Anterior folded part of the ciliary body formed by the ciliary processes.",
      "tags": [
        "Structure",
        "EyeStructure",
        "CS7"
      ],
      "sourceLine": 115,
      "section": "",
      "label": "18"
    },
    {
      "id": "eyeball-model-cs7-116",
      "path": [
        "18"
      ],
      "question": "Function",
      "answer": "Ciliary processes produce aqueous humour and give attachment to zonular fibres suspending the lens.",
      "tags": [
        "Function",
        "EyeStructure",
        "CS7"
      ],
      "sourceLine": 116,
      "section": "",
      "label": "18"
    },
    {
      "id": "eyeball-model-cs7-117",
      "path": [
        "18"
      ],
      "question": "Relations",
      "answer": "Lies posterior to the iris and surrounds the lens circumferentially.",
      "tags": [
        "Relations",
        "EyeStructure",
        "CS7"
      ],
      "sourceLine": 117,
      "section": "",
      "label": "18"
    },
    {
      "id": "eyeball-model-cs7-120",
      "path": [
        "19"
      ],
      "question": "Identification",
      "answer": "Vorticose vein",
      "tags": [
        "Identification",
        "Vein",
        "CS7"
      ],
      "sourceLine": 120,
      "section": "",
      "label": "19"
    },
    {
      "id": "eyeball-model-cs7-121",
      "path": [
        "19"
      ],
      "question": "Location",
      "answer": "Large veins draining the choroid and exiting obliquely through the posterior sclera.",
      "tags": [
        "Location",
        "Vein",
        "CS7"
      ],
      "sourceLine": 121,
      "section": "",
      "label": "19"
    },
    {
      "id": "eyeball-model-cs7-122",
      "path": [
        "19"
      ],
      "question": "Drainage",
      "answer": "Drain the choroidal circulation into ophthalmic veins.",
      "tags": [
        "Drainage",
        "Vein",
        "CS7"
      ],
      "sourceLine": 122,
      "section": "",
      "label": "19"
    },
    {
      "id": "eyeball-model-cs7-123",
      "path": [
        "19"
      ],
      "question": "Relations",
      "answer": "Typically several vorticose veins are distributed around the posterior globe.",
      "tags": [
        "Relations",
        "Vein",
        "CS7"
      ],
      "sourceLine": 123,
      "section": "",
      "label": "19"
    },
    {
      "id": "eyeball-model-cs7-126",
      "path": [
        "20"
      ],
      "question": "Identification",
      "answer": "Long and short ciliary nerves",
      "tags": [
        "Identification",
        "Nerve",
        "CS7"
      ],
      "sourceLine": 126,
      "section": "",
      "label": "20"
    },
    {
      "id": "eyeball-model-cs7-127",
      "path": [
        "20"
      ],
      "question": "Roots",
      "answer": "Long ciliary nerves arise from nasociliary nerve (V1); short ciliary nerves arise from the ciliary ganglion.",
      "tags": [
        "Roots",
        "Nerve",
        "CS7"
      ],
      "sourceLine": 127,
      "section": "",
      "label": "20"
    },
    {
      "id": "eyeball-model-cs7-128",
      "path": [
        "20"
      ],
      "question": "Course",
      "answer": "Pierce the sclera posteriorly and run forward between sclera and choroid.",
      "tags": [
        "Course",
        "Nerve",
        "CS7"
      ],
      "sourceLine": 128,
      "section": "",
      "label": "20"
    },
    {
      "id": "eyeball-model-cs7-129",
      "path": [
        "20"
      ],
      "question": "Sensory functions",
      "answer": "Carry sensory fibres from the eye, particularly the cornea via long ciliary pathways.",
      "tags": [
        "Sensory",
        "Nerve",
        "CS7"
      ],
      "sourceLine": 129,
      "section": "",
      "label": "20"
    },
    {
      "id": "eyeball-model-cs7-130",
      "path": [
        "20"
      ],
      "question": "Autonomic functions",
      "answer": "Short ciliary nerves carry parasympathetic fibres to sphincter pupillae and ciliary muscle; sympathetic fibres travel in both long and short ciliary nerves.",
      "tags": [
        "Autonomic",
        "Nerve",
        "CS7"
      ],
      "sourceLine": 130,
      "section": "",
      "label": "20"
    },
    {
      "id": "eyeball-model-cs7-131",
      "path": [
        "20"
      ],
      "question": "Lesion",
      "answer": "Depending on which fibres are affected, may impair corneal sensation, pupillary constriction or dilation, and accommodation.",
      "tags": [
        "Lesion",
        "Nerve",
        "CS7"
      ],
      "sourceLine": 131,
      "section": "",
      "label": "20"
    },
    {
      "id": "eyeball-model-cs7-134",
      "path": [
        "21"
      ],
      "question": "Identification",
      "answer": "Macula of the retina (macula lutea)",
      "tags": [
        "Identification",
        "RetinalLandmark",
        "CS7"
      ],
      "sourceLine": 134,
      "section": "",
      "label": "21"
    },
    {
      "id": "eyeball-model-cs7-135",
      "path": [
        "21"
      ],
      "question": "Location",
      "answer": "Specialised retinal area lateral to the optic disc; the fovea centralis lies at its centre.",
      "tags": [
        "Location",
        "RetinalLandmark",
        "CS7"
      ],
      "sourceLine": 135,
      "section": "",
      "label": "21"
    },
    {
      "id": "eyeball-model-cs7-136",
      "path": [
        "21"
      ],
      "question": "Function",
      "answer": "Responsible for high-acuity central vision and detailed colour vision.",
      "tags": [
        "Function",
        "RetinalLandmark",
        "CS7"
      ],
      "sourceLine": 136,
      "section": "",
      "label": "21"
    },
    {
      "id": "eyeball-model-cs7-139",
      "path": [
        "22"
      ],
      "question": "Identification",
      "answer": "Retinal artery",
      "tags": [
        "Identification",
        "Artery",
        "CS7"
      ],
      "sourceLine": 139,
      "section": "",
      "label": "22"
    },
    {
      "id": "eyeball-model-cs7-140",
      "path": [
        "22"
      ],
      "question": "Origin",
      "answer": "Central retinal artery is usually a branch of the ophthalmic artery.",
      "tags": [
        "Origin",
        "Artery",
        "CS7"
      ],
      "sourceLine": 140,
      "section": "",
      "label": "22"
    },
    {
      "id": "eyeball-model-cs7-141",
      "path": [
        "22"
      ],
      "question": "Course",
      "answer": "Enters the optic nerve and reaches the retina at the optic disc.",
      "tags": [
        "Course",
        "Artery",
        "CS7"
      ],
      "sourceLine": 141,
      "section": "",
      "label": "22"
    },
    {
      "id": "eyeball-model-cs7-142",
      "path": [
        "22"
      ],
      "question": "Supply",
      "answer": "Supplies the inner layers of the retina.",
      "tags": [
        "Supply",
        "Artery",
        "CS7"
      ],
      "sourceLine": 142,
      "section": "",
      "label": "22"
    },
    {
      "id": "eyeball-model-cs7-143",
      "path": [
        "22"
      ],
      "question": "Clinical relevance",
      "answer": "Occlusion can cause sudden painless monocular visual loss.",
      "tags": [
        "Clinical",
        "Artery",
        "CS7"
      ],
      "sourceLine": 143,
      "section": "",
      "label": "22"
    },
    {
      "id": "eyeball-model-cs7-146",
      "path": [
        "23"
      ],
      "question": "Identification",
      "answer": "Retinal vein",
      "tags": [
        "Identification",
        "Vein",
        "CS7"
      ],
      "sourceLine": 146,
      "section": "",
      "label": "23"
    },
    {
      "id": "eyeball-model-cs7-147",
      "path": [
        "23"
      ],
      "question": "Course",
      "answer": "Central retinal vein drains the retinal venous circulation and leaves through the optic nerve.",
      "tags": [
        "Course",
        "Vein",
        "CS7"
      ],
      "sourceLine": 147,
      "section": "",
      "label": "23"
    },
    {
      "id": "eyeball-model-cs7-148",
      "path": [
        "23"
      ],
      "question": "Drainage",
      "answer": "Drains blood from the retina into the ophthalmic venous system and cavernous sinus circulation.",
      "tags": [
        "Drainage",
        "Vein",
        "CS7"
      ],
      "sourceLine": 148,
      "section": "",
      "label": "23"
    },
    {
      "id": "eyeball-model-cs7-149",
      "path": [
        "23"
      ],
      "question": "Clinical relevance",
      "answer": "Central retinal vein occlusion can cause sudden painless visual impairment with widespread retinal haemorrhages.",
      "tags": [
        "Clinical",
        "Vein",
        "CS7"
      ],
      "sourceLine": 149,
      "section": "",
      "label": "23"
    }
  ]
}
