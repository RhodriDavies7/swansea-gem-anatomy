        "Autonomic",
        "Nerve",
        "Eye",
        "CS2"
      ],
      "sourceLine": 132,
      "section": "Eye",
      "label": "20"
    },
    {
      "id": "eyeball-with-part-of-orbit-model-cs2-133",
      "path": [
        "20"
      ],
      "question": "Lesion",
      "answer": "Depending on which fibres are affected, may impair corneal sensation, pupillary constriction or dilation, and accommodation.",
      "tags": [
        "Lesion",
        "Nerve",
        "Eye",
        "CS2"
      ],
      "sourceLine": 133,
      "section": "Eye",
      "label": "20"
    },
    {
