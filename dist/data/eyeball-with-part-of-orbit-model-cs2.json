        "Course",
        "Artery",
        "Eye",
        "CS2"
      ],
      "sourceLine": 143,
      "section": "Eye",
      "label": "22"
    },
    {
      "id": "eyeball-with-part-of-orbit-model-cs2-144",
      "path": [
        "22"
      ],
      "question": "Supply",
      "answer": "Supplies the inner layers of the retina.",
