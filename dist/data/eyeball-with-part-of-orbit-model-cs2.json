        "Function",
        "EyeStructure",
        "Eye",
        "CS2"
      ],
      "sourceLine": 118,
      "section": "Eye",
      "label": "18"
    },
    {
      "id": "eyeball-with-part-of-orbit-model-cs2-119",
      "path": [
        "18"
      ],
      "question": "Relations",
      "answer": "Lies between choroid posteriorly and iris anteriorly.",
      "tags": [
        "Relations",
        "EyeStructure",
        "Eye",
        "CS2"
      ],
      "sourceLine": 119,
      "section": "Eye",
      "label": "18"
    },
    {
      "id": "eyeball-with-part-of-orbit-model-cs2-122",
      "path": [
        "19"
      ],
      "question": "Identification",
