      ],
      "sourceLine": 128,
      "section": "Eye",
      "label": "20"
    },
    {
      "id": "eyeball-with-part-of-orbit-model-cs2-129",
      "path": [
        "20"
      ],
      "question": "Roots",
      "answer": "Long ciliary nerves arise from nasociliary nerve (V1); short ciliary nerves arise from the ciliary ganglion.",
      "tags": [
        "Roots",
        "Nerve",
        "Eye",
        "CS2"
      ],
      "sourceLine": 129,
      "section": "Eye",
      "label": "20"
    },
    {
      "id": "eyeball-with-part-of-orbit-model-cs2-130",
      "path": [
        "20"
      ],
      "question": "Course",
      "answer": "Pierce sclera posteriorly and run forward between sclera and choroid.",
