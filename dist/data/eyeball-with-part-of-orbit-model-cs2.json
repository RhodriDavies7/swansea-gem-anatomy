      "answer": "Transparent biconvex avascular structure suspended by zonular fibres from the ciliary body.",
      "tags": [
        "Structure",
        "EyeStructure",
        "Eye",
        "CS2"
      ],
      "sourceLine": 85,
      "section": "Eye",
      "label": "13"
    },
    {
      "id": "eyeball-with-part-of-orbit-model-cs2-86",
      "path": [
        "13"
      ],
      "question": "Function",
      "answer": "Focuses light on the retina and changes shape during accommodation.",
      "tags": [
        "Function",
        "EyeStructure",
        "Eye",
        "CS2"
      ],
      "sourceLine": 86,
      "section": "Eye",
      "label": "13"
    },
    {
      "id": "eyeball-with-part-of-orbit-model-cs2-87",
      "path": [
        "13"
      ],
      "question": "Relations",
      "answer": "Lies posterior to iris and anterior to vitreous body.",
      "tags": [
        "Relations",
        "EyeStructure",
        "Eye",
        "CS2"
      ],
      "sourceLine": 87,
      "section": "Eye",
      "label": "13"
    },
    {
      "id": "eyeball-with-part-of-orbit-model-cs2-90",
      "path": [
        "14"
      ],
      "question": "Identification",
      "answer": "Optic nerve sheath meets sclera",
      "tags": [
        "Identification",
        "Landmark",
        "Eye",
        "CS2"
      ],
      "sourceLine": 90,
      "section": "Eye",
      "label": "14"
    },
    {
      "id": "eyeball-with-part-of-orbit-model-cs2-91",
      "path": [
        "14"
      ],
      "question": "Structure",
      "answer": "Posterior junction where the meningeal coverings of the optic nerve become continuous with the sclera of the globe.",
      "tags": [
        "Structure",
        "Landmark",
        "Eye",
        "CS2"
      ],
      "sourceLine": 91,
      "section": "Eye",
      "label": "14"
    },
    {
      "id": "eyeball-with-part-of-orbit-model-cs2-92",
      "path": [
        "14"
      ],
      "question": "Relations",
      "answer": "Surrounds the optic nerve as it enters the posterior eyeball.",
      "tags": [
        "Relations",
        "Landmark",
        "Eye",
        "CS2"
      ],
      "sourceLine": 92,
      "section": "Eye",
      "label": "14"
    },
    {
      "id": "eyeball-with-part-of-orbit-model-cs2-93",
      "path": [
        "14"
      ],
      "question": "Clinical relevance",
      "answer": "Subarachnoid space around the optic nerve is continuous with intracranial CSF space, so raised intracranial pressure can produce papilloedema.",
      "tags": [
        "Clinical",
        "Landmark",
        "Eye",
        "CS2"
      ],
      "sourceLine": 93,
      "section": "Eye",
      "label": "14"
    },
    {
      "id": "eyeball-with-part-of-orbit-model-cs2-96",
      "path": [
        "15"
      ],
      "question": "Identification",
      "answer": "Ciliary nerves entering through sclera",
      "tags": [
        "Identification",
        "Nerve",
        "Eye",
        "CS2"
      ],
      "sourceLine": 96,
      "section": "Eye",
      "label": "15"
    },
    {
      "id": "eyeball-with-part-of-orbit-model-cs2-97",
      "path": [
        "15"
      ],
      "question": "Course",
      "answer": "Long and short ciliary nerves pierce the sclera around the optic nerve and pass forward within the suprachoroidal space.",
      "tags": [
        "Course",
        "Nerve",
        "Eye",
        "CS2"
      ],
      "sourceLine": 97,
      "section": "Eye",
      "label": "15"
    },
    {
      "id": "eyeball-with-part-of-orbit-model-cs2-98",
      "path": [
        "15"
      ],
      "question": "Sensory functions",
      "answer": "Carry sensory fibres from cornea and other ocular structures.",
      "tags": [
        "Sensory",
        "Nerve",
        "Eye",
        "CS2"
      ],
      "sourceLine": 98,
      "section": "Eye",
      "label": "15"
    },
    {
      "id": "eyeball-with-part-of-orbit-model-cs2-99",
      "path": [
        "15"
      ],
      "question": "Autonomic functions",
      "answer": "Carry sympathetic and parasympathetic fibres to structures including iris and ciliary muscle.",
      "tags": [
        "Autonomic",
        "Nerve",
        "Eye",
        "CS2"
      ],
      "sourceLine": 99,
      "section": "Eye",
      "label": "15"
    },
    {
      "id": "eyeball-with-part-of-orbit-model-cs2-100",
      "path": [
        "15"
      ],
      "question": "Lesion",
      "answer": "Damage may impair ocular sensation and autonomic control of the pupil and accommodation, depending on which long or short ciliary fibres are involved.",
      "tags": [
        "Lesion",
        "Nerve",
        "Eye",
        "CS2"
      ],
      "sourceLine": 100,
      "section": "Eye",
      "label": "15"
    },
    {
      "id": "eyeball-with-part-of-orbit-model-cs2-103",
      "path": [
        "16"
      ],
      "question": "Identification",
      "answer": "Optic nerve (CN II)",
      "tags": [
        "Identification",
        "Nerve",
        "Eye",
        "CS2"
      ],
      "sourceLine": 103,
      "section": "Eye",
      "label": "16"
    },
    {
      "id": "eyeball-with-part-of-orbit-model-cs2-104",
      "path": [
        "16"
      ],
      "question": "Roots",
      "answer": "Formed by axons of retinal ganglion cells.",
      "tags": [
        "Roots",
        "Nerve",
        "Eye",
        "CS2"
      ],
      "sourceLine": 104,
      "section": "Eye",
      "label": "16"
    },
    {
      "id": "eyeball-with-part-of-orbit-model-cs2-105",
      "path": [
        "16"
      ],
      "question": "Course",
      "answer": "Leaves the posterior globe, passes through the optic canal and reaches the optic chiasm.",
      "tags": [
        "Course",
        "Nerve",
        "Eye",
        "CS2"
      ],
      "sourceLine": 105,
      "section": "Eye",
      "label": "16"
    },
    {
      "id": "eyeball-with-part-of-orbit-model-cs2-106",
      "path": [
        "16"
      ],
      "question": "Sensory functions",
      "answer": "Vision and afferent limb of the pupillary light reflex.",
      "tags": [
        "Sensory",
        "Nerve",
        "Eye",
        "CS2"
      ],
      "sourceLine": 106,
      "section": "Eye",
      "label": "16"
    },
    {
      "id": "eyeball-with-part-of-orbit-model-cs2-107",
      "path": [
        "16"
      ],
      "question": "Lesion",
      "answer": "Lesion causes ipsilateral monocular visual loss and an afferent pupillary defect.",
      "tags": [
        "Lesion",
        "Nerve",
        "Eye",
        "CS2"
      ],
      "sourceLine": 107,
      "section": "Eye",
      "label": "16"
    },
    {
      "id": "eyeball-with-part-of-orbit-model-cs2-110",
      "path": [
        "17"
      ],
      "question": "Identification",
      "answer": "Ciliary muscle",
      "tags": [
        "Identification",
        "Muscle",
        "Eye",
        "CS2"
      ],
      "sourceLine": 110,
      "section": "Eye",
      "label": "17"
    },
    {
      "id": "eyeball-with-part-of-orbit-model-cs2-111",
      "path": [
        "17"
      ],
      "question": "Actions",
      "answer": "Contracts during accommodation, reducing tension on zonular fibres so the lens becomes more convex for near vision.",
      "tags": [
        "Action",
        "Muscle",
        "Eye",
        "CS2"
      ],
      "sourceLine": 111,
      "section": "Eye",
      "label": "17"
    },
    {
      "id": "eyeball-with-part-of-orbit-model-cs2-112",
      "path": [
        "17"
      ],
      "question": "Innervation",
      "answer": "Parasympathetic fibres from oculomotor nerve via ciliary ganglion and short ciliary nerves.",
      "tags": [
        "Innervation",
        "Muscle",
        "Eye",
        "CS2"
      ],
      "sourceLine": 112,
      "section": "Eye",
      "label": "17"
    },
    {
      "id": "eyeball-with-part-of-orbit-model-cs2-113",
      "path": [
        "17"
      ],
      "question": "Location",
      "answer": "Smooth muscle within the ciliary body.",
      "tags": [
        "Location",
        "Muscle",
        "Eye",
        "CS2"
      ],
      "sourceLine": 113,
      "section": "Eye",
      "label": "17"
    },
    {
