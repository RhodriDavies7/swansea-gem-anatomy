        "Structure",
        "EyeStructure",
        "Eye",
        "CS2"
      ],
      "sourceLine": 117,
      "section": "Eye",
      "label": "18"
    },
    {
      "id": "eyeball-with-part-of-orbit-model-cs2-118",
      "path": [
        "18"
      ],
      "question": "Function",
      "answer": "Produces aqueous humour and controls lens shape through the ciliary muscle and zonular fibres.",
