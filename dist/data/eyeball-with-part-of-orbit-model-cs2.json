        "Location",
        "RetinalLandmark",
        "Eye",
        "CS2"
      ],
      "sourceLine": 137,
      "section": "Eye",
      "label": "21"
    },
    {
      "id": "eyeball-with-part-of-orbit-model-cs2-138",
      "path": [
        "21"
      ],
      "question": "Function",
      "answer": "Responsible for high-acuity central vision and detailed colour vision.",
