        "Supply",
        "Artery",
        "Eye",
        "CS2"
      ],
      "sourceLine": 144,
      "section": "Eye",
      "label": "22"
    },
    {
      "id": "eyeball-with-part-of-orbit-model-cs2-145",
      "path": [
        "22"
      ],
      "question": "Clinical relevance",
      "answer": "Occlusion can cause sudden painless monocular visual loss.",
