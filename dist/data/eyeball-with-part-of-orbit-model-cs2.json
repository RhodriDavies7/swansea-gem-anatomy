        "Identification",
        "Vein",
        "Eye",
        "CS2"
      ],
      "sourceLine": 148,
      "section": "Eye",
      "label": "23"
    },
    {
      "id": "eyeball-with-part-of-orbit-model-cs2-149",
      "path": [
        "23"
      ],
      "question": "Course",
      "answer": "Central retinal vein drains the retinal venous circulation and leaves through the optic nerve.",
      "tags": [
        "Course",
        "Vein",
        "Eye",
        "CS2"
      ],
      "sourceLine": 149,
      "section": "Eye",
      "label": "23"
    },
    {
      "id": "eyeball-with-part-of-orbit-model-cs2-150",
      "path": [
        "23"
      ],
      "question": "Drainage",
      "answer": "Drains blood from the retina into the ophthalmic venous system/cavernous sinus circulation.",
