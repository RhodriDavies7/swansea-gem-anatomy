      "path": [
        "22"
      ],
      "question": "Origin",
      "answer": "Central retinal artery is usually a branch of the ophthalmic artery.",
      "tags": [
        "Origin",
        "Artery",
        "Eye",
        "CS2"
      ],
      "sourceLine": 142,
      "section": "Eye",
      "label": "22"
    },
    {
