        "Course",
        "Nerve",
        "Eye",
        "CS2"
      ],
      "sourceLine": 130,
      "section": "Eye",
      "label": "20"
    },
    {
      "id": "eyeball-with-part-of-orbit-model-cs2-131",
      "path": [
        "20"
      ],
      "question": "Sensory functions",
      "answer": "Carry sensory fibres from the eye, especially cornea via long ciliary pathways.",
