        "Drainage",
        "Vein",
        "Eye",
        "CS2"
      ],
      "sourceLine": 150,
      "section": "Eye",
      "label": "23"
    },
    {
      "id": "eyeball-with-part-of-orbit-model-cs2-151",
      "path": [
        "23"
      ],
      "question": "Clinical relevance",
      "answer": "Central retinal vein occlusion can cause sudden painless visual impairment with widespread retinal haemorrhages.",
      "tags": [
        "Clinical",
        "Vein",
        "Eye",
        "CS2"
      ],
      "sourceLine": 151,
      "section": "Eye",
      "label": "23"
    },
    {
