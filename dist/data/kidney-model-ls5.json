      ],
      "question": "Function",
      "answer": "Transports urine from renal pelvis to urinary bladder by peristalsis.",
      "tags": [
        "Function",
        "Tube",
        "CollectingSystem",
        "LS5"
      ],
      "sourceLine": 63,
      "section": "Collecting system and renal parenchyma",
      "label": "3"
    },
    {
      "id": "kidney-model-ls5-64",
      "path": [
        "3"
      ],
      "question": "Course",
      "answer": "Descends retroperitoneally from renal pelvis, crosses pelvic brim and enters bladder obliquely.",
      "tags": [
        "Course",
        "Tube",
        "CollectingSystem",
        "LS5"
      ],
      "sourceLine": 64,
      "section": "Collecting system and renal parenchyma",
      "label": "3"
    },
    {
      "id": "kidney-model-ls5-65",
      "path": [
        "3"
      ],
      "question": "Constrictions",
      "answer": "Classically at pelviureteric junction, crossing of iliac vessels/pelvic brim, and vesicoureteric junction.",
      "tags": [
        "Constrictions",
        "Tube",
        "CollectingSystem",
        "LS5"
      ],
      "sourceLine": 65,
      "section": "Collecting system and renal parenchyma",
      "label": "3"
    },
    {
      "id": "kidney-model-ls5-66",
      "path": [
        "3"
      ],
      "question": "Clinical relevance",
      "answer": "These constrictions are common sites for ureteric stone impaction.",
