    },
    {
      "id": "kidney-model-ls5-4",
      "path": [
        "A"
      ],
      "question": "Location",
      "answer": "Inner part of the kidney deep to the renal cortex.",
      "tags": [
        "Location",
        "RenalRegion",
        "RenalRegions",
        "LS5"
      ],
      "sourceLine": 4,
      "section": "Renal regions",
      "label": "A"
    },
    {
      "id": "kidney-model-ls5-5",
      "path": [
        "A"
      ],
      "question": "Structure",
      "answer": "Composed mainly of renal pyramids containing loops of Henle, collecting ducts and vasa recta.",
      "tags": [
        "Structure",
        "RenalRegion",
        "RenalRegions",
        "LS5"
      ],
      "sourceLine": 5,
      "section": "Renal regions",
      "label": "A"
    },
    {
      "id": "kidney-model-ls5-6",
      "path": [
        "A"
      ],
      "question": "Function",
      "answer": "Establishes and maintains the medullary osmotic gradient required to concentrate urine.",
      "tags": [
        "Function",
        "RenalRegion",
        "RenalRegions",
        "LS5"
      ],
      "sourceLine": 6,
      "section": "Renal regions",
      "label": "A"
    },
    {
      "id": "kidney-model-ls5-7",
      "path": [
        "A"
      ],
      "question": "Blood supply",
      "answer": "Supplied by vasa recta arising from efferent arterioles of juxtamedullary nephrons.",
      "tags": [
        "BloodSupply",
        "RenalRegion",
        "RenalRegions",
        "LS5"
      ],
      "sourceLine": 7,
      "section": "Renal regions",
      "label": "A"
    },
    {
      "id": "kidney-model-ls5-10",
      "path": [
        "B"
      ],
      "question": "Identification",
      "answer": "Renal cortex",
      "tags": [
        "Identification",
        "RenalRegion",
        "RenalRegions",
        "LS5"
      ],
      "sourceLine": 10,
      "section": "Renal regions",
      "label": "B"
    },
    {
      "id": "kidney-model-ls5-11",
      "path": [
        "B"
      ],
      "question": "Location",
      "answer": "Outer renal tissue beneath the capsule, extending between pyramids as renal columns.",
      "tags": [
        "Location",
        "RenalRegion",
        "RenalRegions",
        "LS5"
      ],
      "sourceLine": 11,
      "section": "Renal regions",
      "label": "B"
    },
    {
      "id": "kidney-model-ls5-12",
      "path": [
        "B"
      ],
      "question": "Structure",
      "answer": "Contains renal corpuscles and proximal/distal convoluted tubules.",
      "tags": [
        "Structure",
        "RenalRegion",
        "RenalRegions",
        "LS5"
      ],
      "sourceLine": 12,
      "section": "Renal regions",
      "label": "B"
    },
    {
      "id": "kidney-model-ls5-13",
      "path": [
        "B"
      ],
      "question": "Function",
      "answer": "Major site of glomerular filtration and tubular reabsorption/secretion.",
      "tags": [
        "Function",
        "RenalRegion",
        "RenalRegions",
        "LS5"
      ],
      "sourceLine": 13,
      "section": "Renal regions",
      "label": "B"
    },
    {
      "id": "kidney-model-ls5-14",
      "path": [
        "B"
      ],
      "question": "Blood supply",
      "answer": "Receives blood through cortical radiate (interlobular) arteries and afferent arterioles.",
      "tags": [
        "BloodSupply",
        "RenalRegion",
        "RenalRegions",
        "LS5"
      ],
      "sourceLine": 14,
      "section": "Renal regions",
      "label": "B"
    },
    {
      "id": "kidney-model-ls5-18",
      "path": [
        "1"
      ],
      "question": "Identification",
      "answer": "Renal vein",
      "tags": [
        "Identification",
        "Vein",
        "RenalVessels",
        "LS5"
      ],
      "sourceLine": 18,
      "section": "Renal vessels",
      "label": "1"
    },
    {
      "id": "kidney-model-ls5-19",
      "path": [
        "1"
      ],
      "question": "Formation",
      "answer": "Formed by convergence of intrarenal venous channels at the renal hilum.",
      "tags": [
        "Formation",
        "Vein",
        "RenalVessels",
        "LS5"
      ],
      "sourceLine": 19,
      "section": "Renal vessels",
      "label": "1"
    },
    {
      "id": "kidney-model-ls5-20",
      "path": [
        "1"
      ],
      "question": "Course",
      "answer": "Leaves the kidney anterior to the renal artery and drains into the inferior vena cava.",
      "tags": [
        "Course",
        "Vein",
        "RenalVessels",
        "LS5"
      ],
      "sourceLine": 20,
      "section": "Renal vessels",
      "label": "1"
    },
    {
      "id": "kidney-model-ls5-21",
      "path": [
        "1"
      ],
      "question": "Relations",
      "answer": "At the hilum the usual anterior-to-posterior arrangement is renal vein, renal artery, renal pelvis/ureter.",
      "tags": [
        "Relations",
        "Vein",
        "RenalVessels",
        "LS5"
      ],
      "sourceLine": 21,
      "section": "Renal vessels",
      "label": "1"
    },
    {
      "id": "kidney-model-ls5-22",
      "path": [
        "1"
      ],
      "question": "Clinical relevance",
      "answer": "The left renal vein passes anterior to the aorta and beneath the superior mesenteric artery and may be compressed in nutcracker syndrome.",
      "tags": [
        "Clinical",
        "Vein",
        "RenalVessels",
        "LS5"
      ],
      "sourceLine": 22,
      "section": "Renal vessels",
      "label": "1"
    },
    {
      "id": "kidney-model-ls5-25",
      "path": [
        "2"
      ],
      "question": "Identification",
      "answer": "Renal artery",
      "tags": [
        "Identification",
        "Artery",
        "RenalVessels",
        "LS5"
      ],
      "sourceLine": 25,
      "section": "Renal vessels",
      "label": "2"
    },
    {
      "id": "kidney-model-ls5-26",
      "path": [
        "2"
      ],
      "question": "Origin",
      "answer": "Direct lateral branch of the abdominal aorta, usually around L1–L2.",
      "tags": [
        "Origin",
        "Artery",
        "RenalVessels",
        "LS5"
      ],
      "sourceLine": 26,
      "section": "Renal vessels",
      "label": "2"
    },
    {
      "id": "kidney-model-ls5-27",
      "path": [
        "2"
      ],
      "question": "Course",
      "answer": "Runs toward the renal hilum; the right renal artery passes posterior to the inferior vena cava.",
      "tags": [
        "Course",
        "Artery",
        "RenalVessels",
        "LS5"
      ],
      "sourceLine": 27,
      "section": "Renal vessels",
      "label": "2"
    },
    {
      "id": "kidney-model-ls5-28",
      "path": [
        "2"
      ],
      "question": "Branches",
      "answer": "Divides into segmental arteries, then interlobar, arcuate and interlobular arteries.",
      "tags": [
        "Branches",
        "Artery",
        "RenalVessels",
        "LS5"
      ],
      "sourceLine": 28,
      "section": "Renal vessels",
      "label": "2"
    },
    {
      "id": "kidney-model-ls5-29",
      "path": [
        "2"
      ],
      "question": "Supply",
      "answer": "Supplies renal parenchyma and gives rise ultimately to afferent arterioles of glomeruli.",
      "tags": [
        "Supply",
        "Artery",
        "RenalVessels",
        "LS5"
      ],
      "sourceLine": 29,
      "section": "Renal vessels",
      "label": "2"
    },
    {
      "id": "kidney-model-ls5-30",
      "path": [
        "2"
      ],
      "question": "Clinical relevance",
      "answer": "Segmental arteries are effectively end arteries, so occlusion may cause segmental renal infarction.",
      "tags": [
        "Clinical",
        "Artery",
        "RenalVessels",
        "LS5"
      ],
      "sourceLine": 30,
      "section": "Renal vessels",
      "label": "2"
    },
    {
      "id": "kidney-model-ls5-33",
      "path": [
        "13"
      ],
      "question": "Identification",
      "answer": "Interlobular artery",
      "tags": [
        "Identification",
        "Artery",
        "RenalVessels",
        "LS5"
      ],
      "sourceLine": 33,
      "section": "Renal vessels",
      "label": "13"
    },
    {
      "id": "kidney-model-ls5-34",
      "path": [
        "13"
      ],
      "question": "Origin",
      "answer": "Arises from arcuate arteries at the corticomedullary junction.",
      "tags": [
        "Origin",
        "Artery",
        "RenalVessels",
        "LS5"
      ],
      "sourceLine": 34,
      "section": "Renal vessels",
      "label": "13"
    },
    {
      "id": "kidney-model-ls5-35",
      "path": [
        "13"
      ],
      "question": "Course",
      "answer": "Radiates outward through the renal cortex toward the capsule.",
      "tags": [
        "Course",
        "Artery",
        "RenalVessels",
        "LS5"
      ],
      "sourceLine": 35,
      "section": "Renal vessels",
      "label": "13"
    },
    {
      "id": "kidney-model-ls5-36",
      "path": [
        "13"
      ],
      "question": "Branches",
      "answer": "Gives rise to afferent arterioles supplying glomeruli.",
      "tags": [
        "Branches",
        "Artery",
        "RenalVessels",
        "LS5"
      ],
      "sourceLine": 36,
      "section": "Renal vessels",
      "label": "13"
    },
    {
      "id": "kidney-model-ls5-37",
      "path": [
        "13"
      ],
      "question": "Supply",
      "answer": "Supplies the renal cortex and glomerular capillary beds via afferent arterioles.",
      "tags": [
        "Supply",
        "Artery",
        "RenalVessels",
        "LS5"
      ],
      "sourceLine": 37,
      "section": "Renal vessels",
      "label": "13"
    },
